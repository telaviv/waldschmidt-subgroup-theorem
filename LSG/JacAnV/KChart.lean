/-- **The chart-comparison identity** (charts 4 and 8). -/
theorem kChart_alg {k : Fin 9} (hk : k = 4 ∨ k = 8) (i j : Fin 2) (t p q : P9) (s0 sk : ℂ)
    (hq : ∀ r, quadA t r = 0)
    (hE1 : (p 0 * q k + t 0 * sk) - (p k * q 0 + t k * s0) = flowW j (t + p) k - flowW j t k - flowW j p k)
    (hPFj : t 0 * q k - t k * q 0 = flowW j t k) (hPFi : ∀ a, t 0 * p a - t a * p 0 = flowW i t a) :
    t 0 * (t k ^ 2 * (t 0 * s0 - p 0 * q 0 + kQ 0 i j t) - t 0 ^ 2 * (t k * sk - p k * q k + kQ k i j t)) = 0 := by
  rcases hk with rfl | rfl <;> fin_cases i <;> fin_cases j
  · exact kChart_4_0_0 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_4_0_1 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_4_1_0 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_4_1_1 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_8_0_0 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_8_0_1 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_8_1_0 t p q s0 sk hq hE1 hPFj hPFi
  · exact kChart_8_1_1 t p q s0 sk hq hE1 hPFj hPFi

