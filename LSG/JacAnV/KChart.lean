    (hPFj : t 0 * q 4 - t 4 * q 0 = flowW 1 t 4) (hPFi : ∀ a, t 0 * p a - t a * p 0 = flowW 0 t a) :
    t 0 * (t 4 ^ 2 * (t 0 * s0 - p 0 * q 0 + kQ 0 0 1 t) - t 0 ^ 2 * (t 4 * sk - p 4 * q 4 + kQ 4 0 1 t)) = 0 := by
