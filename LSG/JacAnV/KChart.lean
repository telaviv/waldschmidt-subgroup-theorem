import LSG.JacAnV.KAlg

/-!
# M2.2 (N1, algebra II): the chart-comparison identity for Lemma K♮

For `k ∈ {4, 8}`: if `t ∈ V(quadA)`, `p`, `q` are vectors and `s₀`, `s_k` scalars satisfying the chart-0 projective flow
relations `t₀ p_a − t_a p₀ = W_i(t)_a`, `t₀ q_k − t_k q₀ = W_j(t)_k` and their derivative
`p₀ q_k + t₀ s_k − p_k q₀ − t_k s₀ = DW_j(t)[p]_k`, then

  `t₀ · (t_k² (t₀ s₀ − p₀ q₀ + 3 t_m t₀) − t₀² (t_k s_k − p_k q_k + Q_{k,ij}(t))) = 0`.

With `t = Θ(z)`, `p = ∂_iΘ`, `q = ∂_jΘ`, `s_c = ∂_i∂_jΘ_c` this says `G₀/Θ₀² = G_k/Θ_k²` (`KLemma.lean`). The proof is a
`linear_combination` of the hypotheses and `kP_zero`; coefficients were generated by `sympy`.
-/

noncomputable section

namespace LSG.JacAnV

open LSG.JacAn

lemma kChart_4_0_0 (t p q : P9) (s0 sk : ℂ) (hq : ∀ r, quadA t r = 0)
    (hE1 : (p 0 * q 4 + t 0 * sk) - (p 4 * q 0 + t 4 * s0) = flowW 0 (t + p) 4 - flowW 0 t 4 - flowW 0 p 4)
    (hPFj : t 0 * q 4 - t 4 * q 0 = flowW 0 t 4) (hPFi : ∀ a, t 0 * p a - t a * p 0 = flowW 0 t a) :
    t 0 * (t 4 ^ 2 * (t 0 * s0 - p 0 * q 0 + kQ 0 0 0 t) - t 0 ^ 2 * (t 4 * sk - p 4 * q 4 + kQ 4 0 0 t)) = 0 := by
  have hP := kP_4_0_0 t hq
  have h0 := hPFi 0; have h1 := hPFi 1; have h2 := hPFi 2; have h3 := hPFi 3; have h4 := hPFi 4
  have h5 := hPFi 5; have h6 := hPFi 6; have h7 := hPFi 7; have h8 := hPFi 8
  simp only [kP, kQ, mIdx, flowW, Matrix.cons_val, Pi.add_apply, Fin.isValue, Fin.reduceEq, ↓reduceIte] at hP hE1 hPFj h0 h1 h2 h3 h4 h5 h6 h7 h8 ⊢
  linear_combination (-t 0 ^ 2 * t 4) * hE1 + (t 0 * (t 4 * p 0 + t 0 * p 4)) * hPFj + ((3)*t 0*t 3*t 4) * h0 + ((-12)*t 0*t 1*t 4) * h1 + ((3)*t 0^2*t 4) * h3 + ((-3)*t 0^2*t 3 + (6)*t 0*t 1^2) * h4 + t 0 * hP

