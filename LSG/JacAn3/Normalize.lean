import LSG.JacAn3.Normal

/-!
# A3.5 (part 2): the normalised lift `θ_N`, its factor, and order 2 (STAGE_A3 §1.5)

`Λ = latt` is the subgroup generated by the four periods `perVec e`. On `Λ`:
* `L` extends `ℝ`-linearly (`Lext`), and `φ(c) = log ‖fac(c, 0)‖ − ½ Re L_c(c)` is additive and extends to an
  `ℝ`-linear `Φ`; `λ = Φ.extendRCLike` is `ℂ`-linear with `Re λ = Φ`;
* `θ_N z := e^{−λ z} θ z` (**`thetaN`**: entire, nowhere zero, on the model, `[θ_N] = E`), with
  **`thetaN_add`**: `θ_N(z + c) = facN c z • θ_N z` and the normalisation (N) in the form
  **`norm_facN`**: `‖facN c z‖ = exp (½ Re L_c(c) + Re L_c(z))`;
* **`facN_bound`**: `‖facN c z‖ ≤ exp (b (‖z‖ + ‖c‖)²)`;
* **`thetaN_order2`**: `‖θ_N z‖ ≤ exp (a ‖z‖² + C)`.
-/

noncomputable section

open Metric Set Filter Topology

namespace LSG.JacAn

open Beta

/-- The period lattice `Λ`. -/
def latt : AddSubgroup (Fin 2 → ℂ) := AddSubgroup.closure (Set.range fun e : Fin 4 => perVec (e : ℕ))

variable {A : A1Facts} {B₁ B₂ : LocalBranch f₅ 2} {p : ℂ × ℂ} {hp : p ∈ dom2 B₁ B₂} {hx : p.1 ≠ p.2}
  {G : GermRad A hp hx} (D : ThetaData G)

lemma isPer_of_mem_latt {c : Fin 2 → ℂ} (hc : c ∈ latt) : IsPer G c :=
  isPer_of_mem_kerE ((lattice_le_ker G).2.1 hc)

lemma isPer_zero : IsPer G 0 := fun z => by rw [add_zero]

lemma ThetaData.fac_zero (z : Fin 2 → ℂ) : D.fac 0 z = 1 := by
  have h := D.fac_spec isPer_zero z
  rw [add_zero] at h
  exact (smul_cancel_of_ne (D.theta_ne_zero z) (h.symm.trans (one_smul ℂ _).symm))

lemma ThetaData.Lf_zero : D.Lf 0 = 0 := by
  have : D.fac 0 = fun _ => 1 := funext D.fac_zero
  simp [ThetaData.Lf, this]

lemma ThetaData.Lf_neg {c : Fin 2 → ℂ} (hc : IsPer G c) (hc' : IsPer G (-c)) : D.Lf (-c) = -D.Lf c := by
  have := D.Lf_add hc hc'
  rw [add_neg_cancel, D.Lf_zero] at this
  rw [eq_neg_iff_add_eq_zero, add_comm]; exact this.symm

/-- `φ(c) = log ‖fac(c, 0)‖ − ½ Re L_c(c)`. -/
def ThetaData.phiN (c : Fin 2 → ℂ) : ℝ := Real.log ‖D.fac c 0‖ - (D.Lf c c).re / 2

lemma ThetaData.log_fac_add {c c' : Fin 2 → ℂ} (hc : IsPer G c) (hc' : IsPer G c') :
    Real.log ‖D.fac (c + c') 0‖ = Real.log ‖D.fac c 0‖ + Real.log ‖D.fac c' 0‖ + (D.Lf c c').re := by
  have h := D.fac_add hc hc' 0
  rw [zero_add, D.fac_affine hc c'] at h
  have ha := norm_pos_iff.mpr (D.fac_ne_zero hc 0)
  have ha' := norm_pos_iff.mpr (D.fac_ne_zero hc' 0)
  rw [h, norm_mul, norm_mul, Complex.norm_exp, Real.log_mul (by positivity) ha'.ne',
    Real.log_mul ha.ne' (Real.exp_pos _).ne', Real.log_exp]
  ring

lemma ThetaData.re_Lf_symm {c c' : Fin 2 → ℂ} (hc : IsPer G c) (hc' : IsPer G c') :
    (D.Lf c c').re = (D.Lf c' c).re := by
  have h1 := D.log_fac_add hc hc'
  have h2 := D.log_fac_add hc' hc
  rw [add_comm c' c] at h2
  linarith

lemma ThetaData.phiN_add {c c' : Fin 2 → ℂ} (hc : IsPer G c) (hc' : IsPer G c') :
    D.phiN (c + c') = D.phiN c + D.phiN c' := by
  unfold ThetaData.phiN
  rw [D.log_fac_add hc hc', D.Lf_add hc hc']
  have := D.re_Lf_symm hc hc'
  simp only [ContinuousLinearMap.add_apply, map_add, Complex.add_re]
  linarith

lemma ThetaData.phiN_zero : D.phiN 0 = 0 := by
  simp [ThetaData.phiN, D.fac_zero, D.Lf_zero]

/-- The `ℝ`-linear extension of `L`. -/
def ThetaData.Lext : (Fin 2 → ℂ) →ₗ[ℝ] ((Fin 2 → ℂ) →L[ℂ] ℂ) :=
  latBasis.constr ℝ fun e => D.Lf (perVec (e : ℕ))

/-- The `ℝ`-linear extension of `φ`. -/
def ThetaData.PhiN : (Fin 2 → ℂ) →ₗ[ℝ] ℝ := latBasis.constr ℝ fun e => D.phiN (perVec (e : ℕ))

lemma ThetaData.ext_agree {c : Fin 2 → ℂ} (hc : c ∈ latt) : D.Lext c = D.Lf c ∧ D.PhiN c = D.phiN c := by
  induction hc using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨e, rfl⟩ := hx
    have h := latBasis_apply e
    refine ⟨?_, ?_⟩
    · simp only [ThetaData.Lext]; rw [← h, latBasis.constr_basis, h]
    · simp only [ThetaData.PhiN]; rw [← h, latBasis.constr_basis, h]
  | zero => exact ⟨by rw [map_zero, D.Lf_zero], by rw [map_zero, D.phiN_zero]⟩
  | add x y hx hy ihx ihy =>
    have px := isPer_of_mem_latt (G := G) hx
    have py := isPer_of_mem_latt (G := G) hy
    exact ⟨by rw [map_add, ihx.1, ihy.1, D.Lf_add px py],
      by rw [map_add, ihx.2, ihy.2, D.phiN_add px py]⟩
  | neg x hx ihx =>
    have px := isPer_of_mem_latt (G := G) hx
    have pnx := isPer_of_mem_latt (G := G) (neg_mem hx)
    refine ⟨by rw [map_neg, ihx.1, D.Lf_neg px pnx], ?_⟩
    have := D.phiN_add px pnx
    rw [add_neg_cancel, D.phiN_zero] at this
    rw [map_neg, ihx.2]; linarith

/-- `λ`: `ℂ`-linear with `Re λ = Φ`. -/
def ThetaData.lamN : Module.Dual ℂ (Fin 2 → ℂ) := Module.Dual.extendRCLike (𝕜 := ℂ) D.PhiN

lemma ThetaData.re_lamN (z : Fin 2 → ℂ) : (D.lamN z).re = D.PhiN z := by
  exact Module.Dual.re_extendRCLike_apply (𝕜 := ℂ) D.PhiN z

/-- **The normalised lift** `θ_N = e^{−λ} θ`. -/
def ThetaData.thetaN (z : Fin 2 → ℂ) : P9 := Complex.exp (-D.lamN z) • D.theta z

/-- The normalised factor. -/
def ThetaData.facN (c z : Fin 2 → ℂ) : ℂ := Complex.exp (-D.lamN c) * D.fac c z

theorem ThetaData.thetaN_ne_zero (z : Fin 2 → ℂ) : D.thetaN z ≠ 0 :=
  smul_ne_zero (Complex.exp_ne_zero _) (D.theta_ne_zero z)

theorem ThetaData.thetaN_onQ (z : Fin 2 → ℂ) : A.OnQ (D.thetaN z) := A.onQ_smul _ _ (D.theta_onQ z)

theorem ThetaData.analyticAt_thetaN (z : Fin 2 → ℂ) : AnalyticAt ℂ D.thetaN z := by
  have hl : AnalyticAt ℂ (fun z => D.lamN z) z :=
    (LinearMap.toContinuousLinearMap D.lamN).analyticAt z
  exact (hl.neg.cexp).smul (D.analyticAt_theta z)

theorem ThetaData.expP_eq_thetaN (z : Fin 2 → ℂ) :
    expP G z = Projectivization.mk ℂ (D.thetaN z) (D.thetaN_ne_zero z) := by
  rw [D.expP_eq_theta, Projectivization.mk_eq_mk_iff']
  refine ⟨Complex.exp (D.lamN z), ?_⟩
  rw [ThetaData.thetaN, smul_smul, ← Complex.exp_add, add_neg_cancel, Complex.exp_zero, one_smul]

theorem ThetaData.thetaN_add {c : Fin 2 → ℂ} (hc : IsPer G c) (z : Fin 2 → ℂ) :
    D.thetaN (z + c) = D.facN c z • D.thetaN z := by
  rw [ThetaData.thetaN, ThetaData.thetaN, ThetaData.facN, D.fac_spec hc, map_add, smul_smul, smul_smul]
  congr 1; rw [neg_add, Complex.exp_add]; ring

lemma aux_exp {a x y : ℝ} (ha : 0 < a) :
    Real.exp (-(Real.log a - x)) * (a * Real.exp y) = Real.exp (x + y) := by
  rw [neg_sub, Real.exp_sub, Real.exp_log ha, Real.exp_add]; field_simp

/-- **The normalisation (N)**: `‖facN c z‖ = exp (½ Re L_c(c) + Re L_c(z))`. -/
theorem ThetaData.norm_facN {c : Fin 2 → ℂ} (hc : c ∈ latt) (z : Fin 2 → ℂ) :
    ‖D.facN c z‖ = Real.exp ((D.Lf c c).re / 2 + (D.Lf c z).re) := by
  have pc := isPer_of_mem_latt (G := G) hc
  have ha := norm_pos_iff.mpr (D.fac_ne_zero pc 0)
  have hΦ : (D.lamN c).re = D.phiN c := by rw [D.re_lamN, (D.ext_agree hc).2]
  rw [ThetaData.facN, D.fac_affine pc, norm_mul, norm_mul, Complex.norm_exp, Complex.norm_exp,
    Complex.neg_re, hΦ, ThetaData.phiN]
  exact aux_exp ha

/-- **The quasi-periodicity bound.** -/
theorem ThetaData.facN_bound : ∃ b ≥ 0, ∀ c ∈ latt, ∀ z : Fin 2 → ℂ,
    ‖D.facN c z‖ ≤ Real.exp (b * (‖z‖ + ‖c‖) ^ 2) := by
  set T := LinearMap.toContinuousLinearMap D.Lext
  refine ⟨‖T‖, norm_nonneg _, fun c hc z => ?_⟩
  rw [D.norm_facN hc z]
  apply Real.exp_le_exp.mpr
  have hL : D.Lf c = T c := by rw [← (D.ext_agree hc).1]; rfl
  have hTc : ‖T c‖ ≤ ‖T‖ * ‖c‖ := T.le_opNorm c
  have h1 : (D.Lf c c).re ≤ ‖T‖ * ‖c‖ * ‖c‖ := by
    rw [hL]
    exact (Complex.re_le_norm _).trans (((T c).le_opNorm c).trans (by gcongr))
  have h2 : (D.Lf c z).re ≤ ‖T‖ * ‖c‖ * ‖z‖ := by
    rw [hL]
    exact (Complex.re_le_norm _).trans (((T c).le_opNorm z).trans (by gcongr))
  have hT := norm_nonneg T
  have hc0 := norm_nonneg c
  have hz0 := norm_nonneg z
  nlinarith [mul_nonneg hT (mul_nonneg hc0 hc0), mul_nonneg hT (mul_nonneg hz0 hz0),
    mul_nonneg hT (mul_nonneg hc0 hz0)]

/-- `4ᵏ ≤ 1 + 4‖z‖²` for the least `k` with `‖z‖ ≤ 2ᵏ`. -/
lemma exists_k_sq (z : Fin 2 → ℂ) : ∃ k : ℕ, ‖z‖ ≤ 2 ^ k ∧ (4 : ℝ) ^ k ≤ 1 + 4 * ‖z‖ ^ 2 := by
  classical
  have hex : ∃ k : ℕ, ‖z‖ ≤ 2 ^ k := by
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖z‖ (by norm_num : (1 : ℝ) < 2)
    exact ⟨k, hk.le⟩
  refine ⟨Nat.find hex, Nat.find_spec hex, ?_⟩
  rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | hpos
  · rw [h0]; norm_num
  · obtain ⟨j, hj⟩ : ∃ j, Nat.find hex = j + 1 := ⟨_, (Nat.succ_pred_eq_of_pos hpos).symm⟩
    have hlt : ¬ ‖z‖ ≤ 2 ^ j := Nat.find_min hex (by omega)
    push Not at hlt
    rw [hj, pow_succ]
    have : (4 : ℝ) ^ j = (2 ^ j) ^ 2 := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
    rw [this]
    have h2j : (0 : ℝ) ≤ 2 ^ j := by positivity
    nlinarith

/-- **Order 2**: `‖θ_N z‖ ≤ exp (a ‖z‖² + C)`. -/
theorem ThetaData.thetaN_order2 : ∃ a C : ℝ, ∀ z, ‖D.thetaN z‖ ≤ Real.exp (a * ‖z‖ ^ 2 + C) := by
  obtain ⟨B, hB⟩ := (isCompact_closedBall (0 : Fin 2 → ℂ) 1).exists_bound_of_continuousOn
    D.continuous_logNorm.continuousOn
  obtain ⟨C₀, hC₀, hd⟩ := D.doubling_log
  have hB' : ∀ z : Fin 2 → ℂ, ‖z‖ ≤ 1 → |Real.log ‖D.theta z‖| ≤ B := fun z hz => by
    have := hB z (by rw [mem_closedBall_zero_iff]; exact hz)
    rwa [Real.norm_eq_abs] at this
  have hd' : ∀ z, |Real.log ‖D.theta ((2 : ℂ) • z)‖ - 4 * Real.log ‖D.theta z‖| ≤ C₀ := fun z => by
    have := hd z; rwa [D.p2_eq_zero, Complex.zero_re, add_zero] at this
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB' 0 (by simp))
  have hdy := dyadic_bound₀ hB' hd' hC₀
  set T := LinearMap.toContinuousLinearMap D.PhiN
  refine ⟨4 * (B + C₀) + ‖T‖, (B + C₀) + ‖T‖, fun z => ?_⟩
  obtain ⟨k, hk, h4⟩ := exists_k_sq z
  have h1 := hdy k z hk
  have hθ := norm_pos_iff.mpr (D.theta_ne_zero z)
  have hl : Real.log ‖D.theta z‖ ≤ (B + C₀) * (1 + 4 * ‖z‖ ^ 2) :=
    (le_abs_self _).trans (h1.trans (mul_le_mul_of_nonneg_left h4 (by positivity)))
  have hPhi : -(D.lamN z).re ≤ ‖T‖ * ‖z‖ := by
    rw [D.re_lamN]
    have : |D.PhiN z| ≤ ‖T‖ * ‖z‖ := by
      have := T.le_opNorm z
      rwa [Real.norm_eq_abs] at this
    linarith [neg_abs_le (D.PhiN z)]
  rw [ThetaData.thetaN, norm_smul, Complex.norm_exp, Complex.neg_re,
    show ‖D.theta z‖ = Real.exp (Real.log ‖D.theta z‖) from (Real.exp_log hθ).symm, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have hT := norm_nonneg T
  have hz := norm_nonneg z
  nlinarith [mul_nonneg hT (sq_nonneg (‖z‖ - 1))]

end LSG.JacAn
