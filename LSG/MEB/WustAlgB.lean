import Mathlib
import LSG.MEB.SliceWust
import LSG.MEB.Deriv

/-!
# Derivation algebra for Wüstholz (A4.4, α; STAGE_A4 §7.3 request (5))

* `DhCoef_add`, `DhCoef_smul`, **`Dh_add_apply`**, **`Dh_smul_apply`**: `Dh ch w` is linear in `w`;
  `pairL ch x P : Tan →ₗ[ℂ] ℂ`, `w ↦ (Dh ch w P)(x)`.
* `Dh_X`, **`Eul_Dh`**: `[Eul_k, Dh ch w] = Dh ch w` (ME's `Eul_Dh`).
* `homOrd W n E`: the ideal spanned by the multihomogeneous elements of `ordIdealB W n E`; **`homOrd_le_VOg`**:
  `homOrd W n E ≤ VOg Dmix (Wmix W) I(E) n` (β's word bridge `DL_Dmix_mem_vanish`).
* **`exists_biorth`**: biorthogonal families for a family of linear forms whose common kernel on `W` lies in `K`.
-/

open MvPolynomial Module

namespace LSG.MEB

variable {m d₀ d₁ : ℕ} {B : Fin m → AbBlock}

/-! ### Linearity of `Dh` in the direction -/

theorem DhCoef_add (ch : ∀ k, Fin (B k).N) (w w' : Tan d₀ d₁ B) (v : Var d₀ d₁ B) :
    DhCoef ch (w + w') v = DhCoef ch w v + DhCoef ch w' v := by
  cases v with
  | x i => simp [DhCoef, add_mul]
  | y j => simp [DhCoef, add_mul]
  | z j => simp only [DhCoef, Prod.snd_add, Prod.fst_add, Pi.add_apply, map_add]; ring
  | e k l =>
    simp only [DhCoef, Prod.snd_add, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    ring

theorem DhCoef_smul (ch : ∀ k, Fin (B k).N) (c : ℂ) (w : Tan d₀ d₁ B) (v : Var d₀ d₁ B) :
    DhCoef ch (c • w) v = C c * DhCoef ch w v := by
  cases v with
  | x i => simp only [DhCoef, Prod.smul_fst, Pi.smul_apply, smul_eq_mul, map_mul]; ring
  | y j => simp only [DhCoef, Prod.smul_snd, Prod.smul_fst, Pi.smul_apply, smul_eq_mul, map_mul]; ring
  | z j => simp only [DhCoef, Prod.smul_snd, Prod.smul_fst, Pi.smul_apply, smul_eq_mul, map_mul]; ring
  | e k l =>
    simp only [DhCoef, Prod.smul_snd, Pi.smul_apply, smul_eq_mul, map_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => by ring

theorem Dh_add_apply (ch : ∀ k, Fin (B k).N) (w w' : Tan d₀ d₁ B) (P : MvPolynomial (Var d₀ d₁ B) ℂ) :
    Dh ch (w + w') P = Dh ch w P + Dh ch w' P := by
  simp only [Dh_apply, DhCoef_add, add_mul, Finset.sum_add_distrib]

theorem Dh_smul_apply (ch : ∀ k, Fin (B k).N) (c : ℂ) (w : Tan d₀ d₁ B)
    (P : MvPolynomial (Var d₀ d₁ B) ℂ) : Dh ch (c • w) P = C c * Dh ch w P := by
  simp only [Dh_apply, DhCoef_smul, Finset.mul_sum, mul_assoc]

theorem Dh_C_mul (ch : ∀ k, Fin (B k).N) (w : Tan d₀ d₁ B) (c : ℂ)
    (x : MvPolynomial (Var d₀ d₁ B) ℂ) : Dh ch w (C c * x) = C c * Dh ch w x := by
  have h0 : Dh ch w (C c) = 0 := by
    rw [← MvPolynomial.algebraMap_eq]; exact Derivation.map_algebraMap _ _
  rw [Derivation.leibniz, h0, smul_zero, add_zero, smul_eq_mul]

/-- The pairing `w ↦ (Dh ch w P)(x)`, linear in `w`. -/
noncomputable def pairL (ch : ∀ k, Fin (B k).N) (x : Var d₀ d₁ B → ℂ)
    (P : MvPolynomial (Var d₀ d₁ B) ℂ) : Tan d₀ d₁ B →ₗ[ℂ] ℂ where
  toFun w := eval x (Dh ch w P)
  map_add' w w' := by rw [Dh_add_apply, map_add]
  map_smul' c w := by rw [Dh_smul_apply, map_mul, eval_C]; rfl

theorem pairL_apply (ch : ∀ k, Fin (B k).N) (x : Var d₀ d₁ B → ℂ)
    (P : MvPolynomial (Var d₀ d₁ B) ℂ) (w : Tan d₀ d₁ B) : pairL ch x P w = eval x (Dh ch w P) :=
  rfl

/-! ### `[Eul_k, Dh] = Dh` -/

theorem Dh_X (ch : ∀ k, Fin (B k).N) (w : Tan d₀ d₁ B) (v : Var d₀ d₁ B) :
    Dh ch w (X v) = DhCoef ch w v := by
  classical
  rw [Dh_apply, Finset.sum_eq_single v (fun b _ hb => by rw [pderiv_X_of_ne (Ne.symm hb), mul_zero])
    (by simp)]
  simp

/-- **`[Eul_k, Dh] = Dh`.** -/
theorem Eul_Dh (k : Fin m) (ch : ∀ k, Fin (B k).N) (w : Tan d₀ d₁ B)
    (x : MvPolynomial (Var d₀ d₁ B) ℂ) :
    Eul k (Dh ch w x) = Dh ch w (Eul k x) + Dh ch w x := by
  have h : ⁅(Eul (d₀ := d₀) (d₁ := d₁) (B := B) k :
      Derivation ℂ (MvPolynomial (Var d₀ d₁ B) ℂ) _), Dh ch w⁆ = Dh ch w := by
    apply MvPolynomial.derivation_ext
    intro v
    rw [Derivation.commutator_apply, Dh_X, Eul_apply k (isWH_DhCoef ch w k v), Eul_X, map_nsmul,
      Dh_X, add_smul, one_smul, add_sub_cancel_right]
  have h' := congrArg (fun D : Derivation ℂ _ _ => D x) h
  simp only [Derivation.commutator_apply] at h'
  linear_combination h'

/-! ### The order bridge for ideals generated by multihomogeneous elements -/

/-- The ideal spanned by the multihomogeneous elements of `ordIdealB W n E`. -/
noncomputable def homOrd (W : Submodule ℂ (Tan d₀ d₁ B)) (n : ℕ) (E : Set (GPt d₀ d₁ B)) :
    Ideal (MvPolynomial (Var d₀ d₁ B) ℂ) :=
  Ideal.span {Q | Q ∈ ordIdealB W n E ∧ ∃ d, IsHomB Q d}

theorem mem_homOrd_of {W : Submodule ℂ (Tan d₀ d₁ B)} {n : ℕ} {E : Set (GPt d₀ d₁ B)}
    {Q : MvPolynomial (Var d₀ d₁ B) ℂ} {d : Fin m → ℕ} (hQ : IsHomB Q d)
    (h : Q ∈ ordIdealB W n E) : Q ∈ homOrd W n E :=
  Ideal.subset_span ⟨h, d, hQ⟩

/-- `IGsem ≤ homOrd` (multihomogeneous components of `IGsem` stay in `IGsem`). -/
theorem IGsem_le_homOrd (W : Submodule ℂ (Tan d₀ d₁ B)) (n : ℕ) (E : Set (GPt d₀ d₁ B)) :
    IGsem d₀ d₁ B ≤ homOrd W n E := by
  intro P hP
  obtain ⟨s, hs⟩ := sum_multiComp P
  rw [hs]
  refine Ideal.sum_mem _ fun d _ => ?_
  have hd := isHomB_iff_wV.mpr (weightedHomogeneousComponent_isWeightedHomogeneous (w := wV) d P)
  exact mem_homOrd_of hd (IGsem_le_ordIdealB n E (multiComp_mem_vanish d hP))

/-- **The order bridge**: `homOrd W n E ≤ VOg Dmix (Wmix W) I(E) n`. -/
theorem homOrd_le_VOg (W : Submodule ℂ (Tan d₀ d₁ B)) (n : ℕ) (E : Set (GPt d₀ d₁ B)) :
    homOrd W n E ≤ LSG.ME.VOg Dmix (Wmix W) (vanish E) n := by
  refine Ideal.span_le.mpr ?_
  rintro Q ⟨hQ, d, hd⟩ l hl hlen
  exact DL_Dmix_mem_vanish hl hd hlen hQ

/-! ### The tangent-space input -/

/-- **The tangent-space bound at every point of every coset** (request (5) to β′, `tz_le_lieAlg`): a direction `w`
along which every multihomogeneous polynomial vanishing on `g + H⁰` has zero derivative at a lift `u` of `g`
lies in `T_{H⁰}`. -/
def TZProp (O : ObstrDataB d₀ d₁ B) : Prop :=
  ∀ (g : GPt d₀ d₁ B) (u : Tan d₀ d₁ B), expG d₀ d₁ B u = g → ∀ w : Tan d₀ d₁ B,
    (∀ (P : MvPolynomial (Var d₀ d₁ B) ℂ) (d : Fin m → ℕ), IsHomB P d →
      P ∈ vanish (gtransl g O.grp) → deriv (fun r : ℂ => eval (liftB (u + r • w)) P) 0 = 0) →
    w ∈ O.tan

/-! ### Biorthogonal families -/

/-- **Biorthogonal families.** If the forms `φ i` have common kernel on `W` inside `K`, there are
`r = dim W − dim (W ⊓ K)` vectors `w_a ∈ W` and indices `i_b` with `φ (i_b) (w_a) = δ_ab`. -/
theorem exists_biorth {V ι : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (φ : ι → V →ₗ[ℂ] ℂ) (W K : Submodule ℂ V)
    (hK : ∀ w ∈ W, (∀ i, φ i w = 0) → w ∈ K) :
    ∀ s ≤ finrank ℂ W - finrank ℂ ↥(W ⊓ K), ∃ (w : Fin s → V) (ind : Fin s → ι),
      (∀ a, w a ∈ W) ∧ ∀ a b, φ (ind b) (w a) = if a = b then 1 else 0 := by
  intro s
  induction s with
  | zero => intro _; exact ⟨Fin.elim0, Fin.elim0, fun a => a.elim0, fun a => a.elim0⟩
  | succ s ih =>
    intro hs
    obtain ⟨w, ind, hwW, hδ⟩ := ih (by omega)
    -- a vector of `W` killed by the chosen forms, outside `K`
    let f : W →ₗ[ℂ] (Fin s → ℂ) := LinearMap.pi fun b => (φ (ind b)).comp W.subtype
    have hrank := LinearMap.finrank_range_add_finrank_ker f
    have hr : finrank ℂ (LinearMap.range f) ≤ s := by
      simpa using Submodule.finrank_le (LinearMap.range f)
    have hex : ∃ x ∈ LinearMap.ker f, (x : V) ∉ K := by
      by_contra hcon
      push_neg at hcon
      have hle : (LinearMap.ker f).map W.subtype ≤ W ⊓ K := by
        rintro _ ⟨x, hx, rfl⟩
        exact ⟨x.2, hcon x hx⟩
      have h1 := Submodule.finrank_mono hle
      rw [Submodule.finrank_map_subtype_eq] at h1
      omega
    obtain ⟨x, hxker, hxK⟩ := hex
    have hx0 : ∀ b, φ (ind b) x = 0 := fun b => congrFun (LinearMap.mem_ker.mp hxker) b
    have : ∃ i, φ i x ≠ 0 := by
      by_contra h
      push_neg at h
      exact hxK (hK x x.2 h)
    obtain ⟨i₀, hi₀⟩ := this
    set x' : V := (φ i₀ x)⁻¹ • (x : V)
    have hx'1 : φ i₀ x' = 1 := by simp [x', hi₀]
    have hx'0 : ∀ b, φ (ind b) x' = 0 := fun b => by simp [x', hx0 b]
    refine ⟨Fin.snoc (fun a => w a - φ i₀ (w a) • x') x', Fin.snoc ind i₀, fun a => ?_,
      fun a b => ?_⟩
    · refine Fin.lastCases ?_ (fun a => ?_) a
      · simpa using W.smul_mem _ x.2
      · simpa using W.sub_mem (hwW a) (W.smul_mem _ (W.smul_mem _ x.2))
    · refine Fin.lastCases ?_ (fun a => ?_) a <;> refine Fin.lastCases ?_ (fun b => ?_) b
      · simp [hx'1]
      · simp [hx'0 b, (Fin.castSucc_ne_last b).symm]
      · simp [hx'1, Fin.castSucc_ne_last]
      · simp [hδ a b, hx'0 b]

end LSG.MEB
