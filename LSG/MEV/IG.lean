import Mathlib
import LSG.MEV.Geom
import LSG.MEV.IGPrime

/-!
# The ideal `I_G̃` of `G̃ = G_a^{d₀} × G_m^{d₁} × E₁^♮ × ⋯ × E_m^♮`

`I_G̃ = (Y_j Z_j − 1, F_k, G_k)`, `F_k` the Weierstrass cubic on the base coordinates `(U, V, W)`
of the `k`-th block, `G_k = W T₃ − V T₁ + 2U²`.

* `lG`, `IG`: the generators (as a list, ordered `YZ`, then all `F`, then all `G`) and the ideal.
* **`IG_isPrime`**: `I_G̃` is prime (any field with `2 ≠ 0`); more generally every `IGsub T₁ T₂ T₃`
  with `T₃ ⊆ T₂` (`G_k` only together with `F_k`) is prime (`LSG.MEV.isPrime_span_FG`,
  `isPrime_span_gensProdS`).
* **`height_IG`**: `(Ideal.ofList lG).height = lG.length = d₁ + 2m` (a complete intersection):
  `≥` by the chain of prime prefixes of the list, `≤` by Krull's height theorem.
* `IG_le_vanish`, `exists_coords_of_rel` (relevant zeros of `I_G̃` are cone representatives),
  **`vanish_univ`**: `I(G̃) = I_G̃` (Hilbert's Nullstellensatz; the boundary
  `U = V = W = 0` of the cone over `X` is reached by polynomial curves of points of `E^♮`).
-/

universe u

open MvPolynomial LSG.Elliptic LSG.Weierstrass PeriodPair

namespace LSG.MEV

variable {K : Type u} [Field K] {d₀ d₁ m : ℕ} (g₂ g₃ : Fin m → K)

/-- `Y_j Z_j − 1`. -/
noncomputable def YZ (K : Type u) [Field K] (d₀ : ℕ) {d₁ : ℕ} (m : ℕ) (j : Fin d₁) :
    MvPolynomial (Var d₀ d₁ m) K :=
  X (.y j) * X (.z j) - 1

/-- The Weierstrass cubic of the `k`-th block (base coordinates). -/
noncomputable def Fk (d₀ d₁ : ℕ) (k : Fin m) : MvPolynomial (Var d₀ d₁ m) K :=
  F (C (g₂ k)) (C (g₃ k)) (X (.e k 0)) (X (.e k 1)) (X (.e k 2))

/-- The fibre relation `G = W T₃ − V T₁ + 2U²` of the `k`-th block. -/
noncomputable def Gk (K : Type u) [Field K] (d₀ d₁ : ℕ) {m : ℕ} (k : Fin m) :
    MvPolynomial (Var d₀ d₁ m) K :=
  Gfib (X (.e k 0)) (X (.e k 1)) (X (.e k 2)) (X (.e k 3)) (X (.e k 4))

/-- The generators of `I_G̃`, as a list. -/
noncomputable def lG : List (MvPolynomial (Var d₀ d₁ m) K) :=
  List.ofFn (YZ K d₀ m) ++ List.ofFn (Fk g₂ g₃ d₀ d₁) ++ List.ofFn (Gk K d₀ d₁)

/-- The ideal `I_G̃`. -/
noncomputable def IG : Ideal (MvPolynomial (Var d₀ d₁ m) K) :=
  Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃)

/-- The ideal generated by some of the generators. -/
noncomputable def IGsub (T₁ : Set (Fin d₁)) (T₂ T₃ : Set (Fin m)) :
    Ideal (MvPolynomial (Var d₀ d₁ m) K) :=
  Ideal.span (YZ K d₀ m '' T₁ ∪ Fk g₂ g₃ d₀ d₁ '' T₂ ∪ Gk K d₀ d₁ '' T₃)

theorem lG_length : (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃).length = d₁ + 2 * m := by
  simp [lG]; ring

theorem IG_eq_IGsub : IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ = IGsub g₂ g₃ Set.univ Set.univ Set.univ := by
  rw [IG, IGsub, Ideal.ofList]
  congr 1
  ext P
  simp [lG, or_assoc]

theorem YZ_mem_IG (j : Fin d₁) : YZ K d₀ m j ∈ IG (d₀ := d₀) g₂ g₃ :=
  Ideal.subset_span (by simp [lG])

theorem Fk_mem_IG (k : Fin m) : Fk g₂ g₃ d₀ d₁ k ∈ IG (d₀ := d₀) g₂ g₃ :=
  Ideal.subset_span (by simp [lG])

theorem Gk_mem_IG (k : Fin m) : Gk K d₀ d₁ k ∈ IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ :=
  Ideal.subset_span (by simp [lG])

/-! ### Primality -/

section Prime

/-- `Var d₀ d₁ m ≃ (Fin m × Fin 5) ⊕ ((Fin d₁ × Fin 2) ⊕ Fin d₀)`. -/
def varEquiv (d₀ d₁ m : ℕ) : Var d₀ d₁ m ≃ (Fin m × Fin 5) ⊕ ((Fin d₁ × Fin 2) ⊕ Fin d₀) where
  toFun
    | .x i => .inr (.inr i)
    | .y j => .inr (.inl (j, 0))
    | .z j => .inr (.inl (j, 1))
    | .e k c => .inl (k, c)
  invFun
    | .inl (k, c) => .e k c
    | .inr (.inl (j, c)) => if c = 0 then .y j else .z j
    | .inr (.inr i) => .x i
  left_inv v := by cases v <;> simp
  right_inv v := by
    rcases v with ⟨k, c⟩ | ⟨j, c⟩ | i
    · rfl
    · fin_cases c <;> rfl
    · rfl

local notation "R₀" => MvPolynomial (Fin d₀) K
local notation "S₁" => MvPolynomial (Fin d₁ × Fin 2) (MvPolynomial (Fin d₀) K)

/-- `K[Var] ≃ K[X][Y, Z][U, V, W, T₁, T₃]`. -/
noncomputable def Θ (K : Type u) [Field K] (d₀ d₁ m : ℕ) :
    MvPolynomial (Var d₀ d₁ m) K ≃ₐ[K]
      MvPolynomial (Fin m × Fin 5) (MvPolynomial (Fin d₁ × Fin 2) (MvPolynomial (Fin d₀) K)) :=
  (renameEquiv K (varEquiv d₀ d₁ m)).trans ((sumAlgEquiv K _ _).trans
    (mapAlgEquiv _ (sumAlgEquiv K _ _)))

theorem Θ_C (a : K) : Θ K d₀ d₁ m (C a) = C (C (C a)) := by
  simp [Θ, sumAlgEquiv_C_inl]

theorem Θ_y (j : Fin d₁) : Θ K d₀ d₁ m (X (.y j)) = C (X (j, 0)) := by
  simp [Θ, varEquiv, sumAlgEquiv_X_inr, sumAlgEquiv_X_inl]

theorem Θ_z (j : Fin d₁) : Θ K d₀ d₁ m (X (.z j)) = C (X (j, 1)) := by
  simp [Θ, varEquiv, sumAlgEquiv_X_inr, sumAlgEquiv_X_inl]

theorem Θ_e (k : Fin m) (c : Fin 5) : Θ K d₀ d₁ m (X (.e k c)) = X (k, c) := by
  simp [Θ, varEquiv, sumAlgEquiv_X_inl]

open Classical in
/-- The `E^♮` relation sets: `F` on `T₂`, `G` on `T₃`. -/
noncomputable def rEV (T₂ T₃ : Set (Fin m)) (k : Fin m) : Set (MvPolynomial (Fin 5) K) :=
  (if k ∈ T₂ then {Fcone5 K (g₂ k) (g₃ k)} else ∅) ∪ (if k ∈ T₃ then {Gcone5 K} else ∅)

/-- The admissible relation sets: `∅`, `{F}`, `{F, G}`. -/
def AdmV (s : Set (MvPolynomial (Fin 5) K)) : Prop :=
  s = ∅ ∨ (∃ a b : K, s = {Fcone5 K a b}) ∨ (∃ a b : K, s = {Fcone5 K a b, Gcone5 K})

set_option maxSynthPendingDepth 10 in
omit g₂ g₃ in
theorem isPrime_span_Fcone5 {R : Type*} [CommRing R] [IsDomain R] [Algebra K R] (h2 : (2 : K) ≠ 0)
    (a b : R) : (Ideal.span {Fcone5 R a b}).IsPrime := by
  have hp := LSG.ME.isPrime_span_F h2 a b
  have h1 : (Ideal.map (Polynomial.C : MvPolynomial (Fin 3) R →+* _)
      (Ideal.span {LSG.ME.Fcone R a b})).IsPrime := Ideal.isPrime_map_C_of_isPrime
  have h2' : (Ideal.map (Polynomial.C : Polynomial (MvPolynomial (Fin 3) R) →+* _)
      (Ideal.map (Polynomial.C : MvPolynomial (Fin 3) R →+* _)
      (Ideal.span {LSG.ME.Fcone R a b}))).IsPrime := Ideal.isPrime_map_C_of_isPrime
  apply LSG.ME.isPrime_of_map_equiv (fgEquiv R).toRingEquiv
  rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton] at h2'
  rw [Ideal.map_span, Set.image_singleton]
  convert h2' using 3
  change fgEquiv R (Fcone5 R a b) = _
  simp only [Fcone5, LSG.ME.Fcone, LSG.Elliptic.F, map_add, map_sub, map_mul, map_pow, map_ofNat,
    fgEquiv_C]
  rw [show (0 : Fin 5) = Fin.castSucc (Fin.castSucc 0) from rfl,
    show (1 : Fin 5) = Fin.castSucc (Fin.castSucc 1) from rfl,
    show (2 : Fin 5) = Fin.castSucc (Fin.castSucc 2) from rfl, fgEquiv_base, fgEquiv_base,
    fgEquiv_base]

omit g₂ g₃ in
theorem hP_FG (h2 : (2 : K) ≠ 0) :
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra K R] (s : Set (MvPolynomial (Fin 5) K)),
      AdmV s → (Ideal.span (MvPolynomial.map (algebraMap K R) '' s)).IsPrime := by
  intro R _ _ _ s hs
  have hF : ∀ a b : K, MvPolynomial.map (algebraMap K R) (Fcone5 K a b) =
      Fcone5 R (algebraMap K R a) (algebraMap K R b) := fun a b => by
    simp [Fcone5, F, map_ofNat]
  have hG : MvPolynomial.map (algebraMap K R) (Gcone5 K) = Gcone5 R := by
    simp [Gcone5, Gfib, map_ofNat]
  rcases hs with rfl | ⟨a, b, rfl⟩ | ⟨a, b, rfl⟩
  · simpa using Ideal.isPrime_bot
  · rw [Set.image_singleton, hF]; exact isPrime_span_Fcone5 h2 _ _
  · rw [Set.image_pair, hF, hG]; exact isPrime_span_FG h2 _ _

theorem Θ_YZ (j : Fin d₁) :
    Θ K d₀ d₁ m (YZ K d₀ m j) =
      C (rename (Prod.mk j) (map (algebraMap K R₀) (X 0 * X 1 - 1 : MvPolynomial (Fin 2) K))) := by
  simp [YZ, Θ_y, Θ_z]

theorem Θ_Fk (k : Fin m) :
    Θ K d₀ d₁ m (Fk g₂ g₃ d₀ d₁ k) =
      rename (Prod.mk k) (map (algebraMap K S₁) (Fcone5 K (g₂ k) (g₃ k))) := by
  simp [Fk, Fcone5, F, Θ_e, Θ_C, MvPolynomial.algebraMap_apply, map_ofNat]

theorem Θ_Gk (k : Fin m) :
    Θ K d₀ d₁ m (Gk K d₀ d₁ k) = rename (Prod.mk k) (map (algebraMap K S₁) (Gcone5 K)) := by
  simp [Gk, Gcone5, Gfib, Θ_e, map_ofNat]

set_option maxSynthPendingDepth 10 in
/-- **Every `IGsub` with `T₃ ⊆ T₂` is prime** (in particular `I_G̃`). -/
theorem IGsub_isPrime (h2 : (2 : K) ≠ 0) (T₁ : Set (Fin d₁)) (T₂ T₃ : Set (Fin m))
    (hT : T₃ ⊆ T₂) : (IGsub (d₀ := d₀) g₂ g₃ T₁ T₂ T₃).IsPrime := by
  classical
  set JT : Ideal S₁ := Ideal.span (LSG.ME.gensProd R₀ (LSG.ME.rT (K := K) T₁)) with hJT
  have hJ : JT.IsPrime := LSG.ME.isPrime_span_gensProd (K := K) _ (LSG.ME.hP_YZ (K := K)) d₁
    (LSG.ME.rT (K := K) T₁) (fun j => by unfold LSG.ME.rT; split_ifs <;> simp) R₀
  set ψ : MvPolynomial (Fin m × Fin 5) S₁ →+* MvPolynomial (Fin m × Fin 5) (S₁ ⧸ JT) :=
    map (Ideal.Quotient.mk JT)
  have hψ : Function.Surjective ψ := map_surjective _ Ideal.Quotient.mk_surjective
  have hmemE : ∀ k, ∀ f ∈ rEV g₂ g₃ T₂ T₃ k,
      (f = Fcone5 K (g₂ k) (g₃ k) ∧ k ∈ T₂) ∨ (f = Gcone5 K ∧ k ∈ T₃) := by
    intro k f hf
    simp only [rEV, Set.mem_union] at hf
    rcases hf with hf | hf <;> split_ifs at hf with hk
    · exact Or.inl ⟨hf, hk⟩
    · exact absurd hf (Set.notMem_empty _)
    · exact Or.inr ⟨hf, hk⟩
    · exact absurd hf (Set.notMem_empty _)
  -- the image of `IGsub` under `Θ`
  have himg : (IGsub (d₀ := d₀) g₂ g₃ T₁ T₂ T₃).map (Θ K d₀ d₁ m).toRingEquiv =
      Ideal.span (C '' LSG.ME.gensProd R₀ (LSG.ME.rT (K := K) T₁) ∪
        gensProdS S₁ (rEV g₂ g₃ T₂ T₃)) := by
    rw [IGsub, Ideal.map_span]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨P, (hP | hP) | hP, rfl⟩
      · obtain ⟨j, hj, rfl⟩ := hP
        refine Ideal.subset_span (Or.inl ⟨_, ⟨j, rfl⟩, ?_⟩)
        change _ = Θ K d₀ d₁ m (YZ K d₀ m j)
        simp only [Θ_YZ, LSG.ME.rT, hj, ite_true]
      · obtain ⟨k, hk, rfl⟩ := hP
        refine Ideal.subset_span (Or.inr (Set.mem_iUnion.mpr ⟨k, Fcone5 K (g₂ k) (g₃ k), ?_, ?_⟩))
        · simp [rEV, hk]
        · change _ = Θ K d₀ d₁ m (Fk g₂ g₃ d₀ d₁ k)
          rw [Θ_Fk]
      · obtain ⟨k, hk, rfl⟩ := hP
        refine Ideal.subset_span (Or.inr (Set.mem_iUnion.mpr ⟨k, Gcone5 K, ?_, ?_⟩))
        · simp [rEV, hk]
        · change _ = Θ K d₀ d₁ m (Gk K d₀ d₁ k)
          rw [Θ_Gk]
    · rw [Ideal.span_le]
      rintro _ (⟨_, ⟨j, rfl⟩, rfl⟩ | hx)
      · by_cases hj : j ∈ T₁
        · refine Ideal.subset_span ⟨YZ K d₀ m j, Or.inl (Or.inl ⟨j, hj, rfl⟩), ?_⟩
          change Θ K d₀ d₁ m (YZ K d₀ m j) = _
          simp only [Θ_YZ, LSG.ME.rT, hj, ite_true]
        · simp only [LSG.ME.rT, hj, ite_false, map_zero, SetLike.mem_coe]
          exact Ideal.zero_mem _
      · obtain ⟨k, f, hf, rfl⟩ := Set.mem_iUnion.mp hx
        rcases hmemE k f hf with ⟨rfl, hk⟩ | ⟨rfl, hk⟩
        · refine Ideal.subset_span ⟨Fk g₂ g₃ d₀ d₁ k, Or.inl (Or.inr ⟨k, hk, rfl⟩), ?_⟩
          change Θ K d₀ d₁ m (Fk g₂ g₃ d₀ d₁ k) = _
          rw [Θ_Fk]
        · refine Ideal.subset_span ⟨Gk K d₀ d₁ k, Or.inr ⟨k, hk, rfl⟩, ?_⟩
          change Θ K d₀ d₁ m (Gk K d₀ d₁ k) = _
          rw [Θ_Gk]
  apply LSG.ME.isPrime_of_map_equiv (Θ K d₀ d₁ m).toRingEquiv
  rw [himg]
  refine LSG.ME.isPrime_of_map_surj ψ hψ _ ?_ ?_
  · rw [ker_map, Ideal.mk_ker, hJT, Ideal.map_span]
    exact Ideal.span_mono Set.subset_union_left
  · have halg : algebraMap K (S₁ ⧸ JT) = (Ideal.Quotient.mk JT).comp (algebraMap K S₁) := by
      ext x; rfl
    have hgen : ∀ (k : Fin m) (f : MvPolynomial (Fin 5) K),
        ψ (rename (Prod.mk k) (map (algebraMap K S₁) f)) =
          rename (Prod.mk k) (map (algebraMap K (S₁ ⧸ JT)) f) := by
      intro k f
      simp only [ψ, map_rename, map_map, halg]
    have : (Ideal.span (C '' LSG.ME.gensProd R₀ (LSG.ME.rT (K := K) T₁) ∪
        gensProdS S₁ (rEV g₂ g₃ T₂ T₃))).map ψ =
        Ideal.span (gensProdS (S₁ ⧸ JT) (rEV g₂ g₃ T₂ T₃)) := by
      rw [Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, (⟨x, hx, rfl⟩ | hx), rfl⟩
        · have : ψ (C x) = 0 := by
            simp only [ψ, map_C, C_eq_zero]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hx)
          rw [SetLike.mem_coe, this]
          exact Ideal.zero_mem _
        · obtain ⟨k, f, hf, rfl⟩ := Set.mem_iUnion.mp hx
          exact Ideal.subset_span (Set.mem_iUnion.mpr ⟨k, f, hf, (hgen k f).symm⟩)
      · rw [Ideal.span_le]
        rintro _ hx
        obtain ⟨k, f, hf, rfl⟩ := Set.mem_iUnion.mp hx
        exact Ideal.subset_span ⟨_, Or.inr (Set.mem_iUnion.mpr ⟨k, f, hf, rfl⟩), hgen k f⟩
    rw [this]
    refine isPrime_span_gensProdS (K := K) AdmV (hP_FG h2) m (rEV g₂ g₃ T₂ T₃) (fun k => ?_) _
    unfold rEV AdmV
    by_cases h₂ : k ∈ T₂ <;> by_cases h₃ : k ∈ T₃
    · exact Or.inr (Or.inr ⟨g₂ k, g₃ k, by simp [h₂, h₃]; exact Set.pair_comm _ _⟩)
    · exact Or.inr (Or.inl ⟨g₂ k, g₃ k, by simp [h₂, h₃]⟩)
    · exact absurd (hT h₃) h₂
    · exact Or.inl (by simp [h₂, h₃])

/-- **`I_G̃` is prime.** -/
theorem IG_isPrime (h2 : (2 : K) ≠ 0) : (IG (d₀ := d₀) (d₁ := d₁) g₂ g₃).IsPrime := by
  rw [IG_eq_IGsub]; exact IGsub_isPrime g₂ g₃ h2 _ _ _ (Set.subset_univ _)

end Prime

/-! ### Height -/

section Height

/-- The `s`-th ideal of the chain: the first `s` generators of `lG`. -/
noncomputable def Jc (d₀ d₁ : ℕ) (s : ℕ) : Ideal (MvPolynomial (Var d₀ d₁ m) K) :=
  IGsub (d₀ := d₀) g₂ g₃ {j | j.val < s} {k | d₁ + k.val < s} {k | d₁ + m + k.val < s}

theorem Jc_mono (s : ℕ) : Jc g₂ g₃ d₀ d₁ s ≤ Jc g₂ g₃ d₀ d₁ (s + 1) := by
  apply Ideal.span_mono
  refine Set.union_subset_union (Set.union_subset_union ?_ ?_) ?_ <;> apply Set.image_mono <;>
    intro x hx <;> simp only [Set.mem_ofPred_eq] at hx ⊢ <;> omega

theorem eval_eq_zero_of_span {s : Set (MvPolynomial (Var d₀ d₁ m) K)} {x : Var d₀ d₁ m → K}
    (hs : ∀ P ∈ s, eval x P = 0) {P : MvPolynomial (Var d₀ d₁ m) K} (hP : P ∈ Ideal.span s) :
    eval x P = 0 := by
  have : Ideal.span s ≤ RingHom.ker (eval x) := Ideal.span_le.mpr fun P hP => hs P hP
  exact this hP

theorem Jc_lt (h2 : (2 : K) ≠ 0) {s : ℕ} (hs : s < d₁ + 2 * m) :
    Jc g₂ g₃ d₀ d₁ s < Jc g₂ g₃ d₀ d₁ (s + 1) := by
  classical
  refine lt_of_le_of_ne (Jc_mono g₂ g₃ s) fun heq => ?_
  by_cases hs1 : s < d₁
  · set j₀ : Fin d₁ := ⟨s, hs1⟩
    let x : Var d₀ d₁ m → K := fun v => match v with
      | .x _ => 0
      | .y j => if j = j₀ then 0 else 1
      | .z j => if j = j₀ then 0 else 1
      | .e _ _ => 0
    have hmem : YZ K d₀ m j₀ ∈ Jc g₂ g₃ d₀ d₁ (s + 1) :=
      Ideal.subset_span (Or.inl (Or.inl ⟨j₀, by simp [j₀], rfl⟩))
    rw [← heq] at hmem
    have := eval_eq_zero_of_span (x := x) ?_ hmem
    · simp [YZ, x] at this
    · rintro _ ((⟨j, hj, rfl⟩ | ⟨k, hk, rfl⟩) | ⟨k, hk, rfl⟩)
      · have : j ≠ j₀ := fun h => by
          simp only [Set.mem_ofPred_eq] at hj; rw [h] at hj; simp [j₀] at hj
        simp [YZ, x, this]
      · simp only [Set.mem_ofPred_eq] at hk; omega
      · simp only [Set.mem_ofPred_eq] at hk; omega
  by_cases hs2 : s < d₁ + m
  · set k₀ : Fin m := ⟨s - d₁, by omega⟩
    let x : Var d₀ d₁ m → K := fun v => match v with
      | .x _ => 0
      | .y _ => 1
      | .z _ => 1
      | .e k c => if k = k₀ ∧ c = 0 then 1 else 0
    have hmem : Fk g₂ g₃ d₀ d₁ k₀ ∈ Jc g₂ g₃ d₀ d₁ (s + 1) :=
      Ideal.subset_span (Or.inl (Or.inr ⟨k₀, by simp [k₀]; omega, rfl⟩))
    rw [← heq] at hmem
    have := eval_eq_zero_of_span (x := x) ?_ hmem
    · have hv : eval x (Fk g₂ g₃ d₀ d₁ k₀) = -(2 * 2) := by
        simp [Fk, F, x]; norm_num
      rw [hv, neg_eq_zero] at this
      exact h2 (mul_self_eq_zero.mp this)
    · rintro _ ((⟨j, hj, rfl⟩ | ⟨k, hk, rfl⟩) | ⟨k, hk, rfl⟩)
      · simp [YZ, x]
      · have : k ≠ k₀ := fun h => by
          simp only [Set.mem_ofPred_eq] at hk; rw [h] at hk; simp [k₀] at hk; omega
        simp [Fk, F, x, this]
      · simp only [Set.mem_ofPred_eq] at hk; omega
  · set k₀ : Fin m := ⟨s - d₁ - m, by omega⟩
    let x : Var d₀ d₁ m → K := fun v => match v with
      | .x _ => 0
      | .y _ => 1
      | .z _ => 1
      | .e k c => if k = k₀ ∧ (c = 1 ∨ c = 3) then 1 else 0
    have hmem : Gk K d₀ d₁ k₀ ∈ Jc g₂ g₃ d₀ d₁ (s + 1) :=
      Ideal.subset_span (Or.inr ⟨k₀, by simp [k₀]; omega, rfl⟩)
    rw [← heq] at hmem
    have := eval_eq_zero_of_span (x := x) ?_ hmem
    · simp [Gk, Gfib, x] at this
    · rintro _ ((⟨j, hj, rfl⟩ | ⟨k, hk, rfl⟩) | ⟨k, hk, rfl⟩)
      · simp [YZ, x]
      · by_cases h : k = k₀
        · subst h; simp [Fk, F, x]
        · simp [Fk, F, x, h]
      · have : k ≠ k₀ := fun h => by
          simp only [Set.mem_ofPred_eq] at hk; rw [h] at hk; simp [k₀] at hk; omega
        simp [Gk, Gfib, x, this]

theorem Jc_top : Jc g₂ g₃ d₀ d₁ (d₁ + 2 * m) = IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ := by
  rw [IG_eq_IGsub, Jc, IGsub]
  congr 4
  all_goals ext x; simp only [Set.mem_ofPred_eq, Set.mem_univ, iff_true]; omega

theorem le_height_Jc (h2 : (2 : K) ≠ 0) :
    ∀ s ≤ d₁ + 2 * m, (s : ℕ∞) ≤ (Jc g₂ g₃ d₀ d₁ s).height := by
  have hpr : ∀ s, (Jc g₂ g₃ d₀ d₁ s).IsPrime := fun s =>
    IGsub_isPrime g₂ g₃ h2 _ _ _ fun k hk => by simp only [Set.mem_ofPred_eq] at hk ⊢; omega
  intro s
  induction s with
  | zero => intro _; simp
  | succ s ih =>
    intro hs
    have := hpr s
    have := hpr (s + 1)
    have h := Ideal.height_add_one_le_of_lt_of_isPrime
      (Jc_lt g₂ g₃ h2 (d₀ := d₀) (by omega : s < d₁ + 2 * m))
    push_cast
    exact le_trans (by gcongr; exact ih (by omega)) h

/-- **`I_G̃` is a complete intersection**: `ht I_G̃ = d₁ + 2m = length lG`. -/
theorem height_IG (h2 : (2 : K) ≠ 0) :
    (Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃)).height =
      (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃).length := by
  classical
  rw [lG_length]
  apply le_antisymm
  · have hne : Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃) ≠ ⊤ := (IG_isPrime g₂ g₃ h2).ne_top
    have hspan : Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃) =
        Ideal.span ((lG (d₀ := d₀) (d₁ := d₁) g₂ g₃).toFinset : Set _) := by
      rw [List.coe_toFinset]
    rw [hspan] at hne ⊢
    refine (Ideal.height_span_le_card_of_span_ne_top hne).trans ?_
    have := List.toFinset_card_le (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃)
    rw [lG_length] at this
    exact_mod_cast this
  · have := le_height_Jc g₂ g₃ (d₀ := d₀) h2 (d₁ + 2 * m) le_rfl
    rw [Jc_top] at this
    exact_mod_cast this

end Height

