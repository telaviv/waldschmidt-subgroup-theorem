import Mathlib
import LSG.MEBV.Slice
import LSG.MEBV.SliceBlock
import LSG.MEB.SliceIG

/-!
# The sliced explicit ideal of `G̃`: Hilbert function, dimension, degree, B5 (M2.5 α; template `LSG.MEB.SliceIG`)

`sl α IGexp = (Y_j Z_j − 1)_j + Σ_k rename_k (I_k + (ℓ_k − 1))` (`slIGexp_eq_blocks`, the shape of StrongSix's
`bezout_blocks`), `ℓ_k` an `X`-only form. The generic spanning lemmas (`mul_mem_span_sup`, `prod_mem_span_sup`,
`card_prod_le`, `hfun_le_of_span`) are MEB's.

* `monomial_eq_prod_pf`: a monomial factors through the blocks.
* **`hfun_slIGexp_le`** (B6, all blocks):
  `H(sl α IGexp; t) ≤ (tD_x + 1)^{d₀} (2 (tD_yz + 1))^{d₁} ∏_k (tD_k + 1)^{g_k+1} n₁_k^{N_k+nT_k}`.
* **`locGen_slIGexp`** (B5): `sl α IGexp` is locally generated by `d₁ + Σ_k (N_k + nT_k − (g_k + 1))` elements.
* **`hdata_slIGexp`**: for `sl α IGexp ≠ (1)`, `hdim = d₀ + d₁ + Σ_k (g_k + 1)` and
  `deg ≤ (d₀ + d₁ + Σ (g_k+1))! · cB · D_x^{d₀} D_yz^{d₁} ∏_k D_k^{g_k+1}`, `cB = 2^{d₁} ∏_k n₁_k^{N_k+nT_k}`.
-/

open MvPolynomial Module Pointwise
open StrongSix.M2 (FLE hfun hdata bdeg)

namespace LSG.MEBV

open LSG.MEB (Blk mul_mem_span_sup prod_mem_span_sup card_prod_le hfun_le_of_span)


variable {m d₀ d₁ : ℕ} {B : Fin m → VBlock}

/-! ### Factoring monomials through the blocks -/

/-- The factor index: `x`-variables, `(y, z)`-pairs, abelian blocks. -/
abbrev FacIx (d₀ d₁ m : ℕ) : Type := Fin d₀ ⊕ Fin d₁ ⊕ Fin m

/-- The factors of the monomial `s`. -/
noncomputable def pf (s : Var d₀ d₁ B →₀ ℕ) : FacIx d₀ d₁ m → MvPolynomial (Var d₀ d₁ B) ℂ
  | .inl i => X (.x i) ^ s (.x i)
  | .inr (.inl j) => X (.y j) ^ s (.y j) * X (.z j) ^ s (.z j)
  | .inr (.inr k) => rename (Var.e (d₀ := d₀) (d₁ := d₁) k) (∏ c : (B k).Idx, X c ^ s (.e k c))

theorem monomial_eq_prod_pf (s : Var d₀ d₁ B →₀ ℕ) :
    monomial s (1 : ℂ) = ∏ i, pf s i := by
  rw [monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  rw [← (Var.equivSum (d₀ := d₀) (d₁ := d₁) (B := B)).symm.prod_comp]
  rw [Fintype.prod_sum_type, Fintype.prod_sum_type, Fintype.prod_sum_type, Fintype.prod_sigma,
    Fintype.prod_sum_type, Fintype.prod_sum_type]
  simp only [pf, map_prod, map_pow, rename_X, Finset.prod_mul_distrib]
  rw [mul_assoc]
  rfl

/-! ### The spanning sets of the factors -/

/-- The spanning sets of the factors at level `t`. -/
noncomputable def Sfac (α : Alpha B) (D : Blk m → ℕ) (t : ℕ) :
    FacIx d₀ d₁ m → Finset (MvPolynomial (Var d₀ d₁ B) ℂ)
  | .inl i => (Finset.range (t * D .x + 1)).image fun a => X (.x i) ^ a
  | .inr (.inl j) => (Finset.range (t * D .yz + 1)).image (fun a => X (.y j) ^ a) ∪
      (Finset.range (t * D .yz + 1)).image (fun a => X (.z j) ^ a)
  | .inr (.inr k) => ((B k).Std (t * D (.e k))).image (rename (Var.e (d₀ := d₀) (d₁ := d₁) k))

theorem card_Sfac_le (α : Alpha B) (D : Blk m → ℕ) (t : ℕ) :
    ∏ i, (Sfac (d₀ := d₀) (d₁ := d₁) α D t i).card ≤
      (t * D .x + 1) ^ d₀ * (2 * (t * D .yz + 1)) ^ d₁ *
        ∏ k, ((t * D (.e k) + 1) ^ ((B k).g + 1) * (B k).n₁ ^ ((B k).N + (B k).nT)) := by
  classical
  simp only [Fintype.prod_sum_type, Sfac]
  rw [mul_assoc]
  refine Nat.mul_le_mul ?_ (Nat.mul_le_mul ?_ ?_)
  · calc ∏ i : Fin d₀, ((Finset.range (t * D .x + 1)).image fun a =>
          (X (.x i) : MvPolynomial (Var d₀ d₁ B) ℂ) ^ a).card
        ≤ ∏ _i : Fin d₀, (t * D .x + 1) :=
          Finset.prod_le_prod' fun i _ => Finset.card_image_le.trans (by simp)
      _ = _ := by simp
  · calc ∏ j : Fin d₁, ((Finset.range (t * D .yz + 1)).image (fun a =>
          (X (.y j) : MvPolynomial (Var d₀ d₁ B) ℂ) ^ a) ∪
          (Finset.range (t * D .yz + 1)).image (fun a => X (.z j) ^ a)).card
        ≤ ∏ _j : Fin d₁, (2 * (t * D .yz + 1)) := by
          refine Finset.prod_le_prod' fun j _ => (Finset.card_union_le _ _).trans ?_
          have h1 := Finset.card_image_le (s := Finset.range (t * D .yz + 1))
            (f := fun a => (X (.y j) : MvPolynomial (Var d₀ d₁ B) ℂ) ^ a)
          have h2 := Finset.card_image_le (s := Finset.range (t * D .yz + 1))
            (f := fun a => (X (.z j) : MvPolynomial (Var d₀ d₁ B) ℂ) ^ a)
          simp only [Finset.card_range] at h1 h2
          omega
      _ = _ := by simp
  · exact Finset.prod_le_prod' fun k _ => Finset.card_image_le.trans ((B k).card_Std_le _)

theorem bdeg_ge_x {D : Blk m → ℕ} {t : ℕ} {s : Var d₀ d₁ B →₀ ℕ}
    (hs : s ∈ StrongSix.M2.S blk (t • D)) (i : Fin d₀) : s (.x i) ≤ t * D .x := by
  have h := hs .x
  simp only [bdeg, Pi.smul_apply, smul_eq_mul] at h
  refine le_trans ?_ h
  have := Finset.single_le_sum (f := fun v : Var d₀ d₁ B => if blk v = Blk.x then s v else 0)
    (fun _ _ => Nat.zero_le _) (Finset.mem_univ (Var.x i))
  simpa using this

theorem bdeg_ge_yz {D : Blk m → ℕ} {t : ℕ} {s : Var d₀ d₁ B →₀ ℕ}
    (hs : s ∈ StrongSix.M2.S blk (t • D)) (j : Fin d₁) :
    s (.y j) + s (.z j) ≤ t * D .yz := by
  classical
  have h := hs .yz
  simp only [bdeg, Pi.smul_apply, smul_eq_mul] at h
  refine le_trans ?_ h
  have hsub : ({Var.y j, Var.z j} : Finset (Var d₀ d₁ B)) ⊆ Finset.univ := Finset.subset_univ _
  have := Finset.sum_le_sum_of_subset (f := fun v : Var d₀ d₁ B =>
    if blk v = Blk.yz then s v else 0) hsub
  rw [Finset.sum_pair (by simp)] at this
  simpa using this

theorem bdeg_ge_e {D : Blk m → ℕ} {t : ℕ} {s : Var d₀ d₁ B →₀ ℕ}
    (hs : s ∈ StrongSix.M2.S blk (t • D)) (k : Fin m) :
    ∑ c, s (.e k c) ≤ t * D (.e k) := by
  classical
  have h := hs (.e k)
  simp only [bdeg, Pi.smul_apply, smul_eq_mul] at h
  refine le_trans ?_ h
  have hinj : Set.InjOn (Var.e (d₀ := d₀) (d₁ := d₁) (B := B) k)
      ((Finset.univ : Finset (B k).Idx) : Set (B k).Idx) :=
    fun a _ b _ hab => by cases hab; rfl
  have hsub : Finset.univ.image (Var.e (d₀ := d₀) (d₁ := d₁) (B := B) k) ⊆ Finset.univ :=
    Finset.subset_univ _
  have := Finset.sum_le_sum_of_subset (f := fun v : Var d₀ d₁ B =>
    if blk v = Blk.e k then s v else 0) hsub
  rw [Finset.sum_image hinj] at this
  simpa using this

/-! ### Membership of the factors -/

theorem rename_e_lform (α : Alpha B) (k : Fin m) :
    rename (Var.e (d₀ := d₀) (d₁ := d₁) k) ((B k).lform (α k)) = lsl α k := by
  simp [VBlock.lform, lsl, map_sum]

theorem map_slB_le (α : Alpha B) (k : Fin m) :
    ((B k).slB (α k)).map (rename (Var.e (d₀ := d₀) (d₁ := d₁) k)) ≤ sl α (IGexp d₀ d₁ B) := by
  rw [VBlock.slB, Ideal.map_sup, Ideal.map_span]
  refine sup_le ?_ (Ideal.span_le.mpr ?_)
  · exact (le_iSup (fun k => ((B k).blockI).map (rename (Var.e (d₀ := d₀) (d₁ := d₁) k))) k).trans
      (le_sup_right.trans le_sup_left)
  · rintro _ ⟨P, hP, rfl⟩
    rw [Set.mem_singleton_iff] at hP
    subst hP
    rw [map_sub, map_one, rename_e_lform]
    exact Ideal.mem_sup_right (Ideal.subset_span ⟨k, rfl⟩)

theorem pf_mem (α : Alpha B) {D : Blk m → ℕ} {t : ℕ} {s : Var d₀ d₁ B →₀ ℕ}
    (hs : s ∈ StrongSix.M2.S blk (t • D)) (i : FacIx d₀ d₁ m) :
    pf s i ∈ Submodule.span ℂ (Sfac α D t i : Set _) ⊔
      (sl α (IGexp d₀ d₁ B)).restrictScalars ℂ := by
  classical
  rcases i with i | j | k
  · refine Submodule.mem_sup_left (Submodule.subset_span ?_)
    simp only [Sfac, pf, Finset.coe_image, Finset.coe_range, Set.mem_image, Set.mem_Iio]
    exact ⟨_, Nat.lt_succ_of_le (bdeg_ge_x hs i), rfl⟩
  · have hyz := bdeg_ge_yz hs j
    have hmem : ∀ e : ℕ, (X (.y j) * X (.z j)) ^ e - 1 ∈ sl α (IGexp d₀ d₁ B) := fun e => by
      have h1 : X (.y j) * X (.z j) - 1 ∈ sl α (IGexp d₀ d₁ B) :=
        Ideal.mem_sup_left (YZ_mem_IGexp (d₀ := d₀) (B := B) j)
      obtain ⟨q, hq⟩ := sub_dvd_pow_sub_pow (X (.y j) * X (.z j) : MvPolynomial (Var d₀ d₁ B) ℂ)
        1 e
      rw [one_pow] at hq
      rw [hq]
      exact Ideal.mul_mem_right _ _ h1
    simp only [pf]
    rcases le_total (s (.z j)) (s (.y j)) with h | h
    · have e : (X (.y j) : MvPolynomial (Var d₀ d₁ B) ℂ) ^ s (.y j) * X (.z j) ^ s (.z j) =
          X (.y j) ^ (s (.y j) - s (.z j)) + X (.y j) ^ (s (.y j) - s (.z j)) *
            ((X (.y j) * X (.z j)) ^ s (.z j) - 1) := by
        obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le h
        rw [hd, Nat.add_sub_cancel_left]; ring
      rw [e]
      refine Submodule.add_mem _ (Submodule.mem_sup_left (Submodule.subset_span ?_))
        (Submodule.mem_sup_right (Ideal.mul_mem_left _ _ (hmem _)))
      simp only [Sfac, Finset.coe_union, Finset.coe_image, Finset.coe_range, Set.mem_union,
        Set.mem_image, Set.mem_Iio]
      exact Or.inl ⟨_, by omega, rfl⟩
    · have e : (X (.y j) : MvPolynomial (Var d₀ d₁ B) ℂ) ^ s (.y j) * X (.z j) ^ s (.z j) =
          X (.z j) ^ (s (.z j) - s (.y j)) + X (.z j) ^ (s (.z j) - s (.y j)) *
            ((X (.y j) * X (.z j)) ^ s (.y j) - 1) := by
        obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le h
        rw [hd, Nat.add_sub_cancel_left]; ring
      rw [e]
      refine Submodule.add_mem _ (Submodule.mem_sup_left (Submodule.subset_span ?_))
        (Submodule.mem_sup_right (Ideal.mul_mem_left _ _ (hmem _)))
      simp only [Sfac, Finset.coe_union, Finset.coe_image, Finset.coe_range, Set.mem_union,
        Set.mem_image, Set.mem_Iio]
      exact Or.inr ⟨_, by omega, rfl⟩
  · -- the abelian block: slice it locally, then rename
    have hdeg : (∏ c : (B k).Idx, X c ^ s (.e k c) : MvPolynomial (B k).Idx ℂ).totalDegree ≤
        t * D (.e k) := by
      refine (totalDegree_finset_prod _ _).trans ((Finset.sum_le_sum fun c _ => ?_).trans
        (bdeg_ge_e hs k))
      exact (totalDegree_X_pow _ _).le
    obtain ⟨a, ha, b', hb', hab⟩ := Submodule.mem_sup.mp
      ((B k).mem_span_Std_slice (α k) hdeg)
    simp only [pf]
    rw [← hab, map_add]
    refine Submodule.add_mem _ (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right ?_)
    · have := Submodule.mem_map_of_mem (f := (rename (Var.e (d₀ := d₀) (d₁ := d₁) k)).toLinearMap)
        ha
      rw [Submodule.map_span] at this
      simpa [Sfac] using this
    · exact map_slB_le α k (Ideal.mem_map_of_mem _ hb')

/-! ### The Hilbert function bound (B6) -/

/-- **The Hilbert function of the sliced explicit ideal** (B6 for every block). -/
theorem hfun_slIGexp_le (α : Alpha B) (D : Blk m → ℕ) (t : ℕ) :
    hfun blk D ℂ (sl α (IGexp d₀ d₁ B)) t ≤
      (t * D .x + 1) ^ d₀ * (2 * (t * D .yz + 1)) ^ d₁ *
        ∏ k, ((t * D (.e k) + 1) ^ ((B k).g + 1) * (B k).n₁ ^ ((B k).N + (B k).nT)) := by
  classical
  refine le_trans ?_ (card_Sfac_le α D t)
  refine le_trans (hfun_le_of_span blk D _ t (∏ i, Sfac α D t i) ?_) (card_prod_le _ _)
  intro P hP
  rw [P.as_sum]
  refine Submodule.sum_mem _ fun s hs => ?_
  have hsS : s ∈ StrongSix.M2.S blk (t • D) := by
    rw [StrongSix.M2.FLE, mem_restrictSupport_iff] at hP; exact hP hs
  rw [← mul_one (P.coeff s), ← smul_eq_mul, ← smul_monomial]
  refine Submodule.smul_mem _ _ ?_
  rw [monomial_eq_prod_pf]
  exact prod_mem_span_sup _ _ _ fun i _ => pf_mem α hsS i

/-! ### Blocks, local generation, dimension and degree -/

/-- **The block form** of the sliced explicit ideal (input of `bezout_blocks`). -/
theorem slIGexp_eq_blocks (α : Alpha B) :
    sl α (IGexp d₀ d₁ B) = Ideal.ofList (lYZ d₀ d₁ B) ⊔
      ⨆ k ∈ (Finset.univ : Finset (Fin m)),
        ((B k).slB (α k)).map (rename (Var.e (d₀ := d₀) (d₁ := d₁) k)) := by
  apply le_antisymm
  · refine sup_le (sup_le le_sup_left (iSup_le fun k => ?_)) (Ideal.span_le.mpr ?_)
    · refine le_trans ?_ le_sup_right
      refine le_trans ?_ (le_iSup₂_of_le k (Finset.mem_univ k) le_rfl)
      exact Ideal.map_mono le_sup_left
    · rintro _ ⟨k, rfl⟩
      refine Ideal.mem_sup_right (Ideal.mem_iSup_of_mem k (Ideal.mem_iSup_of_mem
        (Finset.mem_univ k) ?_))
      show lsl α k - 1 ∈ _
      rw [← rename_e_lform, ← map_one (rename (Var.e (d₀ := d₀) (d₁ := d₁) k)), ← map_sub]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.subset_span rfl))
  · exact sup_le (le_sup_left.trans le_sup_left) (iSup₂_le fun k _ => map_slB_le α k)

/-- **B5 for `G`**: the sliced explicit ideal is locally generated by `d₁ + Σ_k (N_k − g_k)` elements. -/
theorem locGen_slIGexp (α : Alpha B) :
    StrongSix.M2.LocGen (sl α (IGexp d₀ d₁ B)) (d₁ + ∑ k, ((B k).N + (B k).nT - ((B k).g + 1))) := by
  rw [slIGexp_eq_blocks]
  have := StrongSix.M2.locGen_blocks (K := ℂ) Finset.univ
    (fun k => (Var.e (d₀ := d₀) (d₁ := d₁) (B := B) k)) (J := fun k => (B k).slB (α k))
    (r := fun k => (B k).N + (B k).nT - ((B k).g + 1)) (fun k _ => (B k).locGen_slB (α k)) (lYZ d₀ d₁ B)
  rwa [lYZ_length] at this

theorem card_Var : Fintype.card (Var d₀ d₁ B) = d₀ + 2 * d₁ + ∑ k, ((B k).N + (B k).nT) := by
  rw [Fintype.card_congr Var.equivSum]
  simp only [Fintype.card_sum, Fintype.card_fin, Fintype.card_sigma]
  ring

/-- The bounding polynomial `cB (D_x X + 1)^{d₀} (D_yz X + 1)^{d₁} ∏_k (D_k X + 1)^{g_k}`. -/
noncomputable def polB (B : Fin m → VBlock) (d₀ d₁ : ℕ) (D : Blk m → ℕ) : Polynomial ℤ :=
  Polynomial.C ((2 ^ d₁ * ∏ k, (B k).n₁ ^ ((B k).N + (B k).nT) : ℕ) : ℤ) *
    (Polynomial.C (D .x : ℤ) * Polynomial.X + 1) ^ d₀ *
    (Polynomial.C (D .yz : ℤ) * Polynomial.X + 1) ^ d₁ *
    ∏ k, (Polynomial.C (D (.e k) : ℤ) * Polynomial.X + 1) ^ ((B k).g + 1)

/-- The constant `cB = 2^{d₁} ∏_k n₁_k^{N_k}`. -/
def cB (B : Fin m → VBlock) (d₁ : ℕ) : ℕ := 2 ^ d₁ * ∏ k, (B k).n₁ ^ ((B k).N + (B k).nT)

theorem cB_pos : 0 < cB B d₁ :=
  Nat.mul_pos (pow_pos two_pos _)
    (Finset.prod_pos fun k _ => pow_pos (B k).one_le_n₁ _)

theorem polB_data {D : Blk m → ℕ} (hD : ∀ i, 1 ≤ D i) :
    (polB B d₀ d₁ D).natDegree = d₀ + d₁ + ∑ k, ((B k).g + 1) ∧
      (polB B d₀ d₁ D).leadingCoeff =
        (cB B d₁ : ℤ) * (D .x : ℤ) ^ d₀ * (D .yz : ℤ) ^ d₁ * ∏ k, (D (.e k) : ℤ) ^ ((B k).g + 1) ∧
      polB B d₀ d₁ D ≠ 0 := by
  have lin : ∀ a : ℤ, a ≠ 0 → (Polynomial.C a * Polynomial.X + 1).natDegree = 1 ∧
      (Polynomial.C a * Polynomial.X + 1).leadingCoeff = a ∧
      Polynomial.C a * Polynomial.X + 1 ≠ 0 := fun a ha => by
    have h1 := Polynomial.natDegree_linear (b := 1) ha
    have h2 := Polynomial.leadingCoeff_linear (b := (1 : ℤ)) ha
    simp only [map_one] at h1 h2
    refine ⟨h1, h2, fun h0 => ?_⟩
    rw [h0, Polynomial.natDegree_zero] at h1
    omega
  have hx := lin (D .x) (by have := hD .x; omega)
  have hyz := lin (D .yz) (by have := hD .yz; omega)
  have he : ∀ k : Fin m, _ := fun k => lin (D (.e k)) (by have := hD (.e k); omega)
  have hc0 : ((cB B d₁ : ℕ) : ℤ) ≠ 0 := by exact_mod_cast (cB_pos (B := B) (d₁ := d₁)).ne'
  have hC0 : Polynomial.C ((cB B d₁ : ℕ) : ℤ) ≠ 0 := Polynomial.C_ne_zero.mpr hc0
  have hx0 := pow_ne_zero d₀ hx.2.2
  have hyz0 := pow_ne_zero d₁ hyz.2.2
  have hprod0 : ∏ k, (Polynomial.C (D (.e k) : ℤ) * Polynomial.X + 1) ^ ((B k).g + 1) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun k _ => pow_ne_zero _ (he k).2.2
  have hpol : polB B d₀ d₁ D = Polynomial.C ((cB B d₁ : ℕ) : ℤ) *
      (Polynomial.C (D .x : ℤ) * Polynomial.X + 1) ^ d₀ *
      (Polynomial.C (D .yz : ℤ) * Polynomial.X + 1) ^ d₁ *
      ∏ k, (Polynomial.C (D (.e k) : ℤ) * Polynomial.X + 1) ^ ((B k).g + 1) := rfl
  refine ⟨?_, ?_, ?_⟩
  · rw [hpol, Polynomial.natDegree_mul (mul_ne_zero (mul_ne_zero hC0 hx0) hyz0) hprod0,
      Polynomial.natDegree_mul (mul_ne_zero hC0 hx0) hyz0, Polynomial.natDegree_mul hC0 hx0,
      Polynomial.natDegree_C, Polynomial.natDegree_pow, Polynomial.natDegree_pow, hx.1, hyz.1,
      Polynomial.natDegree_prod _ _ fun k _ => pow_ne_zero _ (he k).2.2]
    simp only [Polynomial.natDegree_pow, (he _).1]
    ring
  · rw [hpol, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_mul,
      Polynomial.leadingCoeff_C, Polynomial.leadingCoeff_pow, Polynomial.leadingCoeff_pow, hx.2.1,
      hyz.2.1, Polynomial.leadingCoeff_prod]
    simp only [Polynomial.leadingCoeff_pow, (he _).2.1]
  · rw [hpol]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero hC0 hx0) hyz0) hprod0

theorem polB_eval (D : Blk m → ℕ) (t : ℕ) :
    (polB B d₀ d₁ D).eval (t : ℤ) = (((t * D .x + 1) ^ d₀ * (2 * (t * D .yz + 1)) ^ d₁ *
      ∏ k, ((t * D (.e k) + 1) ^ ((B k).g + 1) * (B k).n₁ ^ ((B k).N + (B k).nT)) : ℕ) : ℤ) := by
  simp only [polB, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_one, Polynomial.eval_prod]
  push_cast
  rw [Finset.prod_mul_distrib, mul_pow]
  ring

/-- **Dimension and degree of the sliced explicit ideal.** -/
theorem hdata_slIGexp (α : Alpha B) {D : Blk m → ℕ} (hD : ∀ i, 1 ≤ D i)
    (hne : sl α (IGexp d₀ d₁ B) ≠ ⊤) :
    (hdata blk D ℂ (sl α (IGexp d₀ d₁ B))).1 = d₀ + d₁ + ∑ k, ((B k).g + 1) ∧
      (hdata blk D ℂ (sl α (IGexp d₀ d₁ B))).2 ≤
        (((d₀ + d₁ + ∑ k, ((B k).g + 1)).factorial * cB B d₁ * D .x ^ d₀ * D .yz ^ d₁ *
          ∏ k, D (.e k) ^ ((B k).g + 1) : ℕ) : ℤ) := by
  classical
  set I := sl α (IGexp d₀ d₁ B)
  have hspec := StrongSix.M2.hdata_spec blk D ℂ hne
  -- lower bound on the dimension (local Krull)
  have hlow : d₀ + d₁ + ∑ k, ((B k).g + 1) ≤ (hdata blk D ℂ I).1 := by
    have hb := StrongSix.M2.hdim_add_height_eq blk D hD hne
    have hht := (locGen_slIGexp (d₀ := d₀) (d₁ := d₁) α).height_le hne
    rw [card_Var] at hb
    obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top hne)
    rw [← hn] at hb hht
    have h1 : (hdata blk D ℂ I).1 + n = d₀ + 2 * d₁ + ∑ k, ((B k).N + (B k).nT) := by
      exact_mod_cast hb
    have h2 : n ≤ d₁ + ∑ k, ((B k).N + (B k).nT - ((B k).g + 1)) := by exact_mod_cast hht
    have h3 : ∑ k, ((B k).N + (B k).nT - ((B k).g + 1)) + ∑ k, ((B k).g + 1) =
        ∑ k, ((B k).N + (B k).nT) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun k _ => Nat.sub_add_cancel (B k).g_lt_N.le
    omega
  obtain ⟨hdeg, hlc, hP0⟩ := polB_data (B := B) (d₀ := d₀) (d₁ := d₁) hD
  have hg := StrongSix.M2.hasData_poly hP0
  rw [hdeg, hlc] at hg
  have hcmp := hspec.compare hg (Filter.Eventually.of_forall fun t => by
      rw [polB_eval]; exact_mod_cast hfun_slIGexp_le α D t)
    (Filter.Eventually.of_forall fun _ => by positivity)
  rcases hcmp with hlt | ⟨heq, hle⟩
  · omega
  · refine ⟨heq, hle.trans (le_of_eq ?_)⟩
    push_cast; ring

end LSG.MEBV
