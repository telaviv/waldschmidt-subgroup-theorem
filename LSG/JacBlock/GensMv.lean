/-- A monomial `c · ∏ X_l`. -/
def mon (c : ℂ) (l : List (Fin 9)) : MvPolynomial (Fin 9) ℂ := C c * (l.map X).prod

@[simp] lemma eval_mon (x : Fin 9 → ℂ) (c : ℂ) (l : List (Fin 9)) :
    eval x (mon c l) = c * (l.map x).prod := by
  simp [mon, map_list_prod, List.map_map, Function.comp_def]

lemma isHomogeneous_listProd (l : List (Fin 9)) :
    ((l.map X).prod : MvPolynomial (Fin 9) ℂ).IsHomogeneous l.length := by
  induction l with
  | nil => simpa using isHomogeneous_one (Fin 9) ℂ
  | cons a l ih =>
    simpa [List.map_cons, List.prod_cons, add_comm] using (isHomogeneous_X ℂ a).mul ih

lemma isHomogeneous_mon (c : ℂ) (l : List (Fin 9)) : (mon c l).IsHomogeneous l.length := by
  simpa [mon] using (isHomogeneous_C (Fin 9) c).mul (isHomogeneous_listProd l)

def gQ0 : MvPolynomial (Fin 9) ℂ := mon (-1) [0, 8] + mon (-1) [1, 3] + mon (1) [2, 2]

def gQ1 : MvPolynomial (Fin 9) ℂ := mon (1) [0, 7] + mon (-2) [1, 5] + mon (2) [2, 4]

def gQ2 : MvPolynomial (Fin 9) ℂ := mon (-2) [1, 6] + mon (1) [2, 5] + mon (1) [3, 4]

def gQ3 : MvPolynomial (Fin 9) ℂ := mon (-1) [0, 4] + mon (-1) [1, 7] + mon (-1) [2, 6] + mon (2) [3, 5]

