def gQ5 : MvPolynomial (Fin 9) ℂ := mon (-1) [0, 2] + mon (-2) [1, 8] + mon (-3) [3, 3] + mon (-1) [4, 6] + mon (1) [5, 5]

def gQ6 : MvPolynomial (Fin 9) ℂ := mon (1) [0, 3] + mon (-4) [1, 1] + mon (-4) [2, 8] + mon (-1) [4, 7] + mon (1) [5, 6]

def gQ7 : MvPolynomial (Fin 9) ℂ := mon (-1) [0, 0] + mon (8) [1, 2] + mon (-2) [3, 8] + mon (-1) [5, 7] + mon (1) [6, 6]

def gQ8 : MvPolynomial (Fin 9) ℂ := mon (8) [0, 1] + mon (4) [2, 3] + mon (4) [4, 5] + mon (-1) [7, 7] + mon (4) [8, 8]

def gC0 : MvPolynomial (Fin 9) ℂ := mon (4) [0, 1, 2] + mon (2) [0, 3, 8] + mon (-1) [0, 5, 7] + mon (4) [1, 3, 3]

def gC1 : MvPolynomial (Fin 9) ℂ := mon (-1) [0, 0, 3] + mon (-1) [0, 5, 6] + mon (2) [1, 2, 3] + mon (2) [2, 2, 2]

