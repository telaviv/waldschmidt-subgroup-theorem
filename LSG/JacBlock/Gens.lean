    (h3 : quad X 3 = 0) (h4 : quad X 4 = 0) (h5 : quad X 5 = 0) (h6 : quad X 6 = 0) (h7 : quad X 7 = 0)
    (h8 : quad X 8 = 0) : X 8 * gensA 11 X = 0 := by
  simp only [quad, Matrix.cons_val, Fin.isValue] at h0 h1 h2 h3 h4 h5 h6 h7 h8
  simp only [gensA, Matrix.cons_val, Fin.isValue]
  linear_combination (-(32 / 15) * X 0 * X 8 + (16 / 5) * X 1 * X 3 + (8 / 15) * X 4 ^ 2 + (1 / 5) * X 6 * X 7) * h0 + (-(1 / 30) * X 0 * X 7 - (8 / 15) * X 1 * X 5 - (4 / 15) * X 2 * X 4 - (4 / 5) * X 6 * X 8) * h1 + (-(2 / 15) * X 0 * X 6 + (8 / 15) * X 1 * X 4 + (16 / 15) * X 5 * X 8) * h2 + (-(1 / 5) * X 2 * X 7 - (8 / 15) * X 4 * X 8) * h3 + ((2 / 15) * X 0 * X 4 + (1 / 5) * X 1 * X 7 + (2 / 5) * X 2 * X 6) * h4 + (-(16 / 15) * X 1 ^ 2 - (16 / 15) * X 2 * X 8) * h5 + (-(4 / 15) * X 0 * X 2 + (8 / 15) * X 1 * X 8) * h6 + (-(4 / 15) * X 0 * X 1 - (2 / 5) * X 2 * X 3) * h7 + (-(1 / 30) * X 0 ^ 2) * h8

lemma cub_zero_2 (X : P9) (h0 : quad X 0 = 0) (h1 : quad X 1 = 0) (h2 : quad X 2 = 0)
    (h3 : quad X 3 = 0) (h4 : quad X 4 = 0) (h5 : quad X 5 = 0) (h6 : quad X 6 = 0) (h7 : quad X 7 = 0)
    (h8 : quad X 8 = 0) : gensA 11 X = 0 := by
  have key : ∀ k : Fin 9, X k * gensA 11 X = 0 := by
    intro k; fin_cases k
    · exact cubMul_2_0 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_1 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_2 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_3 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_4 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_5 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_6 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_7 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cubMul_2_8 X h0 h1 h2 h3 h4 h5 h6 h7 h8
  by_cases h : ∀ k, X k = 0
  · have hX0 : X = 0 := funext h
    subst hX0
    simp [gensA]
  · push_neg at h
    obtain ⟨k, hk⟩ := h
    exact (mul_eq_zero.mp (key k)).resolve_left hk

/-- **The model is cut out by the 12 generators.** -/
theorem onQ_iff_gens (X : P9) : OnQ X ↔ ∀ i, gensA i X = 0 := by
  rw [onQ_iff]
  constructor
  · intro hX
    have h0 := hX 0; have h1 := hX 1; have h2 := hX 2; have h3 := hX 3; have h4 := hX 4
    have h5 := hX 5; have h6 := hX 6; have h7 := hX 7; have h8 := hX 8
    intro i; fin_cases i
    · have h := h0; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h1; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h2; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h3; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h4; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h5; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h6; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h7; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · have h := h8; simp only [quad, Matrix.cons_val, Fin.isValue] at h; simp only [gensA, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h
    · exact cub_zero_0 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cub_zero_1 X h0 h1 h2 h3 h4 h5 h6 h7 h8
    · exact cub_zero_2 X h0 h1 h2 h3 h4 h5 h6 h7 h8
  · intro h i
    fin_cases i
    · have h' := h 0; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 1; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 2; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 3; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 4; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 5; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 6; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 7; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'
    · have h' := h 8; simp only [gensA, Matrix.cons_val, Fin.isValue] at h'; simp only [quad, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk]; linear_combination h'

end LSG.JacBlock
