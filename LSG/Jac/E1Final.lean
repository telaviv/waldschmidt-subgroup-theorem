lemma law0C_eq (X Y : P9) : law0C X Y = fun k : Fin 9 => evalSP X Y (law k 0) := rfl

lemma dupC_eq (X : P9) : dupC X = fun k : Fin 9 => evalSP X X (law k 4) := rfl

lemma derivAlong_apply (W : Fin 2 → P9 → P9) (j : Fin 2) (dF : Fin 9 → P9 → P9) (X : P9) (l : Fin 9) :
    derivAlong W j dF X l = ∑ i : Fin 9, W j X i * dF i X l := by
  simp [derivAlong, Finset.sum_apply]

lemma flowW_eq_Wn (j : Fin 2) (Z : P9) (l : Fin 9) : flowW j Z l = Wn Z j l / 2 := flowW_eq j Z l

lemma W4C_apply (j : Fin 2) (Z : P9) (l : Fin 9) : W4C j Z l = W4n Z j l / 4 := rfl

lemma deriv_law0_W4 (X Y : P9) (j : Fin 2) (l : Fin 9) :
    derivAlong W4C j (fun i X => dlaw0C i X Y) X l = evalSP X Y (DAX0W4 j l) / 4 := by
  rw [derivAlong_apply, DAX0W4_eval, Finset.sum_div]
  exact sum_congr rfl fun i _ => by simp only [W4C_apply, dlaw0C]; ring

lemma deriv_law0_W (X Y : P9) (j : Fin 2) (l : Fin 9) :
    derivAlong flowW j (fun i X => dlaw0C i X Y) X l = evalSP X Y (DAX0W j l) / 2 := by
  rw [derivAlong_apply, DAX0W_eval, Finset.sum_div]
  exact sum_congr rfl fun i _ => by simp only [flowW_eq_Wn, dlaw0C]; ring

lemma deriv_dup_W4 (X : P9) (j : Fin 2) (l : Fin 9) :
    derivAlong W4C j ddupC X l = (evalSP X X (DAX4W4 j l) + evalSP X X (DAY4W4 j l)) / 4 := by
  rw [derivAlong_apply, DAX4W4_eval, DAY4W4_eval, ← Finset.sum_add_distrib, Finset.sum_div]
  exact sum_congr rfl fun i _ => by simp only [W4C_apply, ddupC]; ring

theorem E1_40C (X Y : P9) (hX : OnQ X) (hY : OnQ Y) (j : Fin 2) (l : Fin 9) :
    law0C X Y 0 * derivAlong W4C j (fun i X => dlaw0C i X Y) X l -
      law0C X Y l * derivAlong W4C j (fun i X => dlaw0C i X Y) X 0 = X 4 * flowW j (law0C X Y) l := by
  rw [deriv_law0_W4, deriv_law0_W4, flowW_eq_Wn, law0C_eq]
  have h := e40_main X Y hX hY j l
  simp only [fin9_val_0, fin9_val_1, fin9_val_2, fin9_val_3, fin9_val_4, fin9_val_5, fin9_val_6, fin9_val_7, fin9_val_8] at h ⊢
  linear_combination h / 8

theorem E1_44C (X Y : P9) (hX : OnQ X) (hY : OnQ Y) (j : Fin 2) (l : Fin 9) :
    law0C X Y 4 * derivAlong W4C j (fun i X => dlaw0C i X Y) X l -
      law0C X Y l * derivAlong W4C j (fun i X => dlaw0C i X Y) X 4 = X 4 * W4C j (law0C X Y) l := by
  rw [deriv_law0_W4, deriv_law0_W4, W4C_apply, law0C_eq]
  have h := e44_main X Y hX hY j l
  simp only [fin9_val_0, fin9_val_1, fin9_val_2, fin9_val_3, fin9_val_4, fin9_val_5, fin9_val_6, fin9_val_7, fin9_val_8] at h ⊢
  linear_combination h / 16

theorem E1_4C (X Y : P9) (hX : OnQ X) (hY : OnQ Y) (j : Fin 2) (l : Fin 9) :
    law0C X Y 4 * derivAlong flowW j (fun i X => dlaw0C i X Y) X l -
      law0C X Y l * derivAlong flowW j (fun i X => dlaw0C i X Y) X 4 = X 0 * W4C j (law0C X Y) l := by
  rw [deriv_law0_W, deriv_law0_W, W4C_apply, law0C_eq]
  have h := e04_main X Y hX hY j l
  simp only [fin9_val_0, fin9_val_1, fin9_val_2, fin9_val_3, fin9_val_4, fin9_val_5, fin9_val_6, fin9_val_7, fin9_val_8] at h ⊢
  linear_combination h / 8

theorem E2_4C (X : P9) (hX : OnQ X) (j : Fin 2) (l : Fin 9) :
    dupC X 4 * derivAlong W4C j ddupC X l - dupC X l * derivAlong W4C j ddupC X 4 =
      2 * X 4 * W4C j (dupC X) l := by
  rw [deriv_dup_W4, deriv_dup_W4, W4C_apply, dupC_eq]
  have h1 := f4x_main X X hX hX j l
  have h2 := f4y_main X X hX hX j l
  simp only [fin9_val_0, fin9_val_1, fin9_val_2, fin9_val_3, fin9_val_4, fin9_val_5, fin9_val_6, fin9_val_7, fin9_val_8] at h1 h2 ⊢
  linear_combination (h1 + h2) / 16

/-- **The interface instance** `A1Facts` (STAGE_A2 §7), with every field proved. -/
def a1Facts : A1Facts := mkA1Facts E1_40C E1_44C E1_4C E2_4C dup_ne_zeroC

