/-- **The Wronskian relation** (times 4). -/
theorem W4rel (j : ℕ) (hj : j < 2) (l : Fin 9) (x : Fin 9 → K) (hx : OnQ x) :
    x 4 * (2 * Wn x j l) = x 0 * W4n x j l - x l * W4n x j 0 := by
  interval_cases j <;> fin_cases l
  · exact W4rel_0_0 x hx
  · exact W4rel_0_1 x hx
  · exact W4rel_0_2 x hx
  · exact W4rel_0_3 x hx
  · exact W4rel_0_4 x hx
  · exact W4rel_0_5 x hx
  · exact W4rel_0_6 x hx
  · exact W4rel_0_7 x hx
  · exact W4rel_0_8 x hx
  · exact W4rel_1_0 x hx
  · exact W4rel_1_1 x hx
  · exact W4rel_1_2 x hx
  · exact W4rel_1_3 x hx
  · exact W4rel_1_4 x hx
  · exact W4rel_1_5 x hx
  · exact W4rel_1_6 x hx
  · exact W4rel_1_7 x hx
  · exact W4rel_1_8 x hx

