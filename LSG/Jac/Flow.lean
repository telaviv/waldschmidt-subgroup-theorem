/-- **Flow invariance of law 0** (F1). -/
theorem flow_inv (j : ℕ) (hj : j < 2) (l : Fin 9) (x y : Fin 9 → R) (hx : OnQ x) (hy : OnQ y) :
    Bf x y * (y 0 * ∑ i ∈ range 9, Wn x j i * evalSP x y (dXsp i (law l 0)) -
      x 0 * ∑ i ∈ range 9, Wn y j i * evalSP x y (dYsp i (law l 0))) =
      3 * GBf x y j * A32 l 0 x y := by
  interval_cases j <;> fin_cases l
  · exact flow_inv_0_0 x y hx hy
  · exact flow_inv_0_1 x y hx hy
  · exact flow_inv_0_2 x y hx hy
  · exact flow_inv_0_3 x y hx hy
  · exact flow_inv_0_4 x y hx hy
  · exact flow_inv_0_5 x y hx hy
  · exact flow_inv_0_6 x y hx hy
  · exact flow_inv_0_7 x y hx hy
