lemma add_pow_nine {R : Type*} [CommRing R] {a b : R} (ha : a ^ 5 = 0) (hb : b ^ 5 = 0) : (a + b) ^ 9 = 0 := by
  rw [add_pow]
  refine Finset.sum_eq_zero fun k hk => ?_
  have hk9 : k ≤ 9 := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
  rcases le_or_gt 5 k with h | h
  · rw [show a ^ k = a ^ 5 * a ^ (k - 5) by rw [← pow_add]; congr 1; omega, ha]; simp
  · rw [show b ^ (9 - k) = b ^ 5 * b ^ (9 - k - 5) by rw [← pow_add]; congr 1; omega, hb]; simp

lemma X4_mem : (X 4 : R12) ^ 9 ∈ KV := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  have h4 : Ideal.Quotient.mk KV (X 4) = -(Ideal.Quotient.mk KV (X 0) + Ideal.Quotient.mk KV (X 8)) := by
    rw [eq_neg_iff_add_eq_zero, ← map_add, ← map_add, Ideal.Quotient.eq_zero_iff_mem]
    have : (X 4 + (X 0 + X 8) : R12) = X 0 + X 4 + X 8 := by ring
    rw [this]; exact ell_mem
  have h0 : Ideal.Quotient.mk KV (X 0) ^ 5 = 0 := by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact b6v_0_mem
  have h8 : Ideal.Quotient.mk KV (X 8) ^ 5 = 0 := by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact b6v_8_mem
  rw [map_pow, h4, neg_pow, add_pow_nine h0 h8, mul_zero]

/-- The exponents `e_v` (`X`: 5, `X₄`: 9, `T`: 1). -/
def eV : Fin 12 → ℕ := ![5, 5, 5, 5, 9, 5, 5, 5, 5, 1, 1, 1]

lemma powV_mem (v : Fin 12) : (X v : R12) ^ eV v ∈ KV := by
  fin_cases v <;> simp only [eV, Fin.zero_eta, Fin.isValue, Fin.reduceFinMk, Matrix.cons_val, pow_one]
  · exact b6v_0_mem
  · exact b6v_1_mem
  · exact b6v_2_mem
  · exact b6v_3_mem
  · exact X4_mem
  · exact b6v_5_mem
  · exact b6v_6_mem
  · exact b6v_7_mem
  · exact b6v_8_mem
  · exact T9_mem
  · exact T10_mem
  · exact T11_mem

lemma monomialV_mem_of_le (s : Fin 12 →₀ ℕ) (v : Fin 12) (hv : eV v ≤ s v) : monomial s (1 : ℂ) ∈ KV := by
  have hle : Finsupp.single v (eV v) ≤ s := by
    intro i; by_cases h : i = v
    · subst h; simpa using hv
    · simp [Finsupp.single_apply, Ne.symm h]
  have : monomial s (1 : ℂ) = X v ^ eV v * monomial (s - Finsupp.single v (eV v)) 1 := by
    rw [X_pow_eq_monomial, monomial_mul, one_mul, add_tsub_cancel_of_le hle]
  rw [this]; exact Ideal.mul_mem_right _ _ (powV_mem v)

lemma monomialV_mem (s : Fin 12 →₀ ℕ) (hs : 40 < ∑ i, s i) : monomial s (1 : ℂ) ∈ KV := by
  by_contra hne
  have hlt : ∀ v, s v + 1 ≤ eV v := fun v => by
    by_contra h; push_neg at h; exact hne (monomialV_mem_of_le s v (by omega))
  have : ∑ i, s i ≤ 40 := by
    have h2 := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hlt i)
    simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      smul_eq_mul, mul_one] at h2
    have h3 : ∑ i, eV i = 52 := by simp [eV, Fin.sum_univ_succ]
    omega
  omega

/-- **B6 for `A^♮`**: every homogeneous polynomial of degree 41 lies in `(gensV) + (T₀, T₄, T₈, X₀ + X₄ + X₈)`. -/
theorem hilbV (M : R12) (hM : M.IsHomogeneous 41) :
    M ∈ Ideal.span {Q | Q ∈ gensV} ⊔ Ideal.span (Set.range fun a => lformV (hilbL a)) := by
  show M ∈ KV
  rw [M.as_sum]
  refine Ideal.sum_mem _ fun s hs => ?_
  have hdeg : ∑ i, s i = 41 := by
    have := hM (mem_support_iff.mp hs)
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using this
  have : monomial s (M.coeff s) = C (M.coeff s) * monomial s 1 := by
    rw [C_mul_monomial, mul_one]
  rw [this]
  exact Ideal.mul_mem_left _ _ (monomialV_mem s (by omega))

/-- **The Wronskian cocycle** (M2.1.2): `X₀P48 − X₄P08 + X₈P04 = −½X₅Q₁ − X₁Q₅ − ¾C₀`. -/
theorem kappaV : X 0 * P48V - X 4 * P08V + X 8 * P04V =
    -(C (1 / 2) * X 5 * rename ι9 gQ1) - X 1 * rename ι9 gQ5 - C (3 / 4) * rename ι9 gC0 := by
  apply MvPolynomial.funext; intro x
  simp [P48V, P08V, P04V, gQ1, gQ5, gC0, mon]
  ring

