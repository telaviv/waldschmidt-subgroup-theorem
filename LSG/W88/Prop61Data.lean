import LSG.AuxFun.LemmaU
import LSG.AuxFun.Chart

/-!
# The arithmetic data of Lemma U from the hypotheses of W88 Prop. 6.1 (Stage 3)

**`LSG.Aux.exists_LUData`**: for `g₂, g₃` algebraic, `W` rational over `ℚ̄` and `y_j ∈ Λ(G)` there are
a number field `K ⊂ ℂ` (an `IntermediateField` generated by finitely many algebraic numbers), a basis
`w` of `W` with algebraic coordinates and `LUData` with these `y`, `w`.
-/

open Complex Finset LSG.Elliptic LSG.Weierstrass LSG.W88 PeriodPair NumberField

noncomputable section

namespace LSG.Aux

variable {d0 d1 m : ℕ}

/-- The cone representative of `exp_E(z)`: `O` on the lattice, `(℘, ℘', 1)` otherwise. -/
def conePt (L : PeriodPair) (z : ℂ) : Fin 3 → ℂ := by
  classical exact if z ∈ L.lattice then O else ![℘[L] z, ℘'[L] z, 1]

lemma isRep_conePt (L : PeriodPair) (z : ℂ) : IsRep L z (conePt L z) := by
  classical
  unfold conePt
  split_ifs with hz
  · refine ⟨fun h => by simpa [O] using congrFun h 1, Fv_O _ _, ?_⟩
    rw [toPoint_O, expE_of_mem L hz]; rfl
  · exact isRep_affine L hz

lemma isAlgebraic_derivWp (L : PeriodPair) (hg : IsAlgebraic ℚ L.g₂ ∧ IsAlgebraic ℚ L.g₃)
    {z : ℂ} (hz : z ∉ L.lattice) (h : IsAlgebraic ℚ (℘[L] z)) : IsAlgebraic ℚ (℘'[L] z) := by
  refine IsAlgebraic.of_pow (n := 2) two_pos ?_
  rw [L.derivWeierstrassP_sq z hz]
  have h4 : IsAlgebraic ℚ (4 : ℂ) := by simpa using isAlgebraic_algebraMap (R := ℚ) (A := ℂ) 4
  exact ((h4.mul (h.pow 3)).sub (hg.1.mul h)).sub hg.2

lemma isAlgebraic_conePt (L : PeriodPair) (hg : IsAlgebraic ℚ L.g₂ ∧ IsAlgebraic ℚ L.g₃) {z : ℂ}
    (hz : z ∈ L.lattice ∨ IsAlgebraic ℚ (℘[L] z)) (i : Fin 3) : IsAlgebraic ℚ (conePt L z i) := by
  classical
  unfold conePt
  split_ifs with h
  · fin_cases i <;> simp [O, isAlgebraic_zero, isAlgebraic_one]
  · have hp := hz.resolve_left h
    fin_cases i
    · exact hp
    · exact isAlgebraic_derivWp L hg h hp
    · simpa using isAlgebraic_one

/-- **Construction of the data of Lemma U.** -/
theorem exists_LUData (Ls : Fin m → PeriodPair)
    (hg : ∀ k, IsAlgebraic ℚ (Ls k).g₂ ∧ IsAlgebraic ℚ (Ls k).g₃)
    (W : Submodule ℂ (Tan d0 d1 m)) (hW : RationalOverQbarTan W) {μ : ℕ}
    (y : Fin μ → Tan d0 d1 m) (hyL : ∀ j, y j ∈ Lam Ls) :
    ∃ (K : Type) (_ : Field K) (_ : NumberField K) (ι : K →+* ℂ) (τ : ℕ)
      (Dt : LUData (d0 := d0) (d1 := d1) Ls ι μ τ),
      Dt.y = y ∧ Submodule.span ℂ (Set.range Dt.w) = W := by
  classical
  -- a basis of `W` with algebraic coordinates
  set St : Set (Tan d0 d1 m) := {w | w ∈ W ∧ AlgVec w.1 ∧ AlgVec w.2.1 ∧ AlgVec w.2.2}
  obtain ⟨b, hbS, hbspan, hbli⟩ := exists_linearIndependent ℂ St
  have hbfin : b.Finite := hbli.setFinite
  obtain ⟨bF, hbF⟩ := hbfin.exists_finset_coe
  set τ := bF.card
  let w : Fin τ → Tan d0 d1 m := fun r => (bF.equivFin.symm r : Tan d0 d1 m)
  have hwb : ∀ r, w r ∈ b := fun r => by rw [← hbF]; exact (bF.equivFin.symm r).2
  have hrange : Set.range w = b := by
    ext x; constructor
    · rintro ⟨r, rfl⟩; exact hwb r
    · intro hx
      have hx' : x ∈ bF := by rw [← hbF] at hx; exact hx
      exact ⟨bF.equivFin ⟨x, hx'⟩, by simp [w]⟩
  have hspan : Submodule.span ℂ (Set.range w) = W := by
    rw [hrange, hbspan]; exact hW.symm
  have hwS : ∀ r, w r ∈ St := fun r => hbS (hwb r)
  -- the finite set of algebraic numbers
  let X₀ : Fin μ → Fin m → Fin 3 → ℂ := fun j k => conePt (Ls k) ((y j).2.2 k)
  let val : ((Fin μ × Fin d0) ⊕ (Fin μ × Fin d1) ⊕ (Fin μ × Fin m × Fin 3) ⊕ (Fin τ × Fin d0) ⊕
      (Fin τ × Fin d1) ⊕ (Fin τ × Fin m) ⊕ Fin m ⊕ Fin m ⊕ Fin m ⊕ Fin m) → ℂ := fun a =>
    match a with
    | .inl ji => (y ji.1).1 ji.2
    | .inr (.inl ji) => exp ((y ji.1).2.1 ji.2)
    | .inr (.inr (.inl jki)) => X₀ jki.1 jki.2.1 jki.2.2
    | .inr (.inr (.inr (.inl ri))) => (w ri.1).1 ri.2
    | .inr (.inr (.inr (.inr (.inl ri)))) => (w ri.1).2.1 ri.2
    | .inr (.inr (.inr (.inr (.inr (.inl rk))))) => (w rk.1).2.2 rk.2
    | .inr (.inr (.inr (.inr (.inr (.inr (.inl k)))))) => (Ls k).g₂
    | .inr (.inr (.inr (.inr (.inr (.inr (.inr (.inl k))))))) => (Ls k).g₃
    | .inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inl k)))))))) => ℘[Ls k] (zh (Ls k))
    | .inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr k)))))))) => (Ls k).g₂ / 2
  let Fs : Finset ℂ := univ.image val
  have hval : ∀ a, val a ∈ Fs := fun a => mem_image_of_mem _ (mem_univ a)
  have halg : ∀ x ∈ Fs, IsAlgebraic ℚ x := by
    intro x hx
    obtain ⟨a, -, rfl⟩ := mem_image.mp hx
    rcases a with ji | ji | jki | ri | ri | rk | k | k | k | k
    · exact (hyL ji.1).1 ji.2
    · exact (hyL ji.1).2.1 ji.2
    · exact isAlgebraic_conePt (Ls jki.2.1) (hg jki.2.1) ((hyL jki.1).2.2 jki.2.1) jki.2.2
    · exact (hwS ri.1).2.1 ri.2
    · exact (hwS ri.1).2.2.1 ri.2
    · exact (hwS rk.1).2.2.2 rk.2
    · exact (hg k).1
    · exact (hg k).2
    · exact isAlgebraic_weierstrassP_half (Ls k) (hg k).1 (hg k).2 (Ls k).ω₁_mem_lattice
        (Ls k).ω₁_div_two_notMem_lattice
    · have h2 : IsAlgebraic ℚ ((2 : ℂ)⁻¹) := by
        simpa using isAlgebraic_algebraMap (R := ℚ) (A := ℂ) (2⁻¹ : ℚ)
      simpa [val, div_eq_mul_inv] using (hg k).1.mul h2
  -- the number field
  let F := IntermediateField.adjoin ℚ (Fs : Set ℂ)
  haveI : FiniteDimensional ℚ F :=
    IntermediateField.finiteDimensional_adjoin fun x hx => (halg x hx).isIntegral
  haveI : NumberField F := ⟨⟩
  let ι : F →+* ℂ := F.val.toRingHom
  have hmem : ∀ x ∈ Fs, x ∈ F := fun x hx => IntermediateField.subset_adjoin ℚ _ hx
  -- sizes
  choose dn hdn1 hdni using fun x : Fs => exists_den (⟨x.1, hmem x.1 x.2⟩ : F)
  set H : ℝ := 1 + ∑ x : Fs, house (⟨x.1, hmem x.1 x.2⟩ : F)
  set d : ℕ := ∏ x : Fs, dn x
  have hH : 1 ≤ H := by
    have := sum_nonneg fun x (_ : x ∈ (univ : Finset Fs)) => house_nonneg (⟨x.1, hmem x.1 x.2⟩ : F)
    simp only [H]; linarith
  have hd : 1 ≤ d := Nat.one_le_iff_ne_zero.mpr (prod_ne_zero_iff.mpr fun x _ => by
    have := hdn1 x; omega)
  have hsz : ∀ x ∈ Fs, Sz ι H d x := by
    intro x hx
    refine ⟨⟨x, hmem x hx⟩, rfl, ?_, ?_⟩
    · have := single_le_sum (f := fun x : Fs => house (⟨x.1, hmem x.1 x.2⟩ : F))
        (fun x _ => house_nonneg _) (mem_univ ⟨x, hx⟩)
      simp only [H]; linarith
    · have hdv : dn ⟨x, hx⟩ ∣ d := dvd_prod_of_mem _ (mem_univ _)
      obtain ⟨e, he⟩ := hdv
      have : ((d : ℕ) : F) * ⟨x, hmem x hx⟩ = (e : F) * ((dn ⟨x, hx⟩ : F) * ⟨x, hmem x hx⟩) := by
        rw [he]; push_cast; ring
      rw [this]
      have he' : IsIntegral ℤ (e : F) := by
        simpa using isIntegral_algebraMap (R := ℤ) (A := F) (x := (e : ℤ))
      exact he'.mul (hdni _)
  refine ⟨F, inferInstance, inferInstance, ι, τ,
    { y := y, w := w, X₀ := X₀,
      γ₂ := fun k => ⟨(Ls k).g₂, hmem _ (hval (.inr (.inr (.inr (.inr (.inr (.inr (.inl k))))))))⟩,
      γ₃ := fun k => ⟨(Ls k).g₃, hmem _
        (hval (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inl k)))))))))⟩,
      H := H, d := d, hH := hH, hd := hd,
      hγ₂ := fun k => rfl, hγ₃ := fun k => rfl,
      ha := fun j i => hsz _ (hval (.inl (j, i))),
      hb := fun j i => hsz _ (hval (.inr (.inl (j, i)))),
      hX₀ := fun j k => isRep_conePt (Ls k) _,
      hX₀s := fun j k i => hsz _ (hval (.inr (.inr (.inl (j, k, i))))),
      hw0 := fun r i => hsz _ (hval (.inr (.inr (.inr (.inl (r, i)))))),
      hw1 := fun r i => hsz _ (hval (.inr (.inr (.inr (.inr (.inl (r, i))))))),
      hw2 := fun r k => hsz _ (hval (.inr (.inr (.inr (.inr (.inr (.inl (r, k)))))))),
      he₁ := fun k => hsz _ (hval (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inl k)))))))))),
      hg₂ := fun k => hsz _ (hval (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr k)))))))))) },
    rfl, hspan⟩

end LSG.Aux
