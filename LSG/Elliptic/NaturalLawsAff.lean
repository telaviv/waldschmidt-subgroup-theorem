import LSG.Elliptic.NaturalLawsPoly

/-!
# Affine identities for the generic case of (b)

At affine points `(x, y, 1)` of `E` (`y² = 4x³ − g₂x − g₃`), with `d = x₁ − x₂`,
`N₃ = (y₁ − y₂)² − 4(x₁ + x₂)d²` (`= 4d² x₃`) and
`Y₃ = −2(y₁ − y₂)(N₃ − 4d²x₁) − 8d³y₁` (`= 8d³ y₃`):
* `affE1ᵢ`: `4d² lawᵢU = lawᵢW N₃`, `affE2ᵢ`: `8d³ lawᵢV = lawᵢW Y₃`;
* `affK1ᵢλμ`: `d (κᵂ + 2μ lawᵢW ρ_λ + 2λ lawᵢW ρ_μ) = M lawᵢW (y₁ − y₂)`;
* `affK3ᵢλμ`: `16d⁴ (κⱽ + 2μ lawᵢV ρ_λ + 2λ lawᵢV ρ_μ) = M lawᵢW (2Y₃(y₁ − y₂) + 4N₃²)`;
(`λ(P) ∈ {y₁, 1}`, `ρ_V = 2x²`, `ρ_W = 0`). Cofactors generated by `affine_ids.py` (sympy).
-/

namespace LSG.Elliptic

variable {R : Type*} [CommRing R] {g₂ g₃ x₁ y₁ x₂ y₂ : R}
  (hP : y₁ ^ 2 = 4 * x₁ ^ 3 - g₂ * x₁ - g₃) (hQ : y₂ ^ 2 = 4 * x₂ ^ 3 - g₂ * x₂ - g₃)

/-- `N₃ = 4(x₁ − x₂)² x₃`. -/
def affN3 (x₁ y₁ x₂ y₂ : R) : R :=
  (y₁ - y₂) ^ 2 - 4 * (x₁ + x₂) * (x₁ - x₂) ^ 2

/-- `Y₃ = 8(x₁ − x₂)³ y₃`. -/
def affY3 (x₁ y₁ x₂ y₂ : R) : R :=
  -2 * (y₁ - y₂) * (affN3 x₁ y₁ x₂ y₂ - 4 * (x₁ - x₂) ^ 2 * x₁) - 8 * (x₁ - x₂) ^ 3 * y₁

include hP hQ in
theorem affE1₁ :
    4 * (x₁ - x₂) ^ 2 * law₁U g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 =
      law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * affN3 x₁ y₁ x₂ y₂ := by
  linear_combination (norm := (simp only [law₁U, law₁W, affN3]; ring))
    (g₂*x₂ + g₃ + 12*x₁^2*x₂ - 24*x₁*x₂^2 + 8*x₂^3 - y₁^2 + 2*y₁*y₂) * hP +
    (-g₂*x₁ - g₃ - 8*x₁^3 + 24*x₁^2*x₂ - 12*x₁*x₂^2 - 2*y₁*y₂ + y₂^2) * hQ

include hP hQ in
theorem affE2₁ :
    8 * (x₁ - x₂) ^ 3 * law₁V g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 =
      law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * affY3 x₁ y₁ x₂ y₂ := by
  linear_combination (norm := (simp only [law₁V, law₁W, affY3, affN3]; ring))
    (-2*g₂*x₂*y₁ + 6*g₂*x₂*y₂ - 2*g₃*y₁ + 6*g₃*y₂ - 24*x₁^2*x₂*y₁ + 24*x₁^2*x₂*y₂
      + 48*x₁*x₂^2*y₁ - 48*x₁*x₂^2*y₂ - 16*x₂^3*y₁ + 2*y₁^3 - 6*y₁^2*y₂ + 4*y₁*y₂^2
      + 4*y₂^3) * hP +
    (2*g₂*x₁*y₁ - 6*g₂*x₁*y₂ + 2*g₃*y₁ - 6*g₃*y₂ + 16*x₁^3*y₁ - 48*x₁^2*x₂*y₁
      + 48*x₁^2*x₂*y₂ + 24*x₁*x₂^2*y₁ - 24*x₁*x₂^2*y₂ - 6*y₁*y₂^2 + 2*y₂^3) * hQ

include hP hQ in
theorem affE1₂ :
    4 * (x₁ - x₂) ^ 2 * law₂U g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 =
      law₂W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * affN3 x₁ y₁ x₂ y₂ := by
  linear_combination (norm := (simp only [law₂U, law₂W, affN3]; ring))
    (4*g₂*x₁*y₁ + 4*g₂*x₁*y₂ + 8*g₂*x₂*y₁ - 12*g₂*x₂*y₂ + 12*g₃*y₁ - 8*g₃*y₂
      - 48*x₁^2*x₂*y₂ - 48*x₁*x₂^2*y₁ + 48*x₁*x₂^2*y₂ + 32*x₂^3*y₂ - 4*y₁^2*y₂ + 4*y₁*y₂^2
      + 4*y₂^3) * hP +
    (-16*g₂*x₁*y₁ + 4*g₂*x₁*y₂ + 4*g₂*x₂*y₁ + 4*g₂*x₂*y₂ - 12*g₃*y₁ + 8*g₃*y₂ + 48*x₁^3*y₁
      + 16*x₁^3*y₂ + 48*x₁^2*x₂*y₁ - 48*x₁^2*x₂*y₂ - 48*x₁*x₂^2*y₁ - 4*y₁*y₂^2) * hQ

include hP hQ in
theorem affE2₂ :
    8 * (x₁ - x₂) ^ 3 * law₂V g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 =
      law₂W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * affY3 x₁ y₁ x₂ y₂ := by
  linear_combination (norm := (simp only [law₂V, law₂W, affY3, affN3]; ring))
    (8*g₂^2*x₁^2 + 16*g₂^2*x₁*x₂ + 32*g₂*g₃*x₁ + 16*g₂*g₃*x₂ - 192*g₂*x₁^2*x₂^2
      - 128*g₂*x₁*x₂^3 - 8*g₂*x₁*y₁^2 + 40*g₂*x₁*y₂^2 + 128*g₂*x₂^4 - 16*g₂*x₂*y₁^2
      + 40*g₂*x₂*y₁*y₂ - 24*g₂*x₂*y₂^2 + 24*g₃^2 - 384*g₃*x₁*x₂^2 + 192*g₃*x₂^3
      - 24*g₃*y₁^2 + 40*g₃*y₁*y₂ + 16*g₃*y₂^2 + 1152*x₁^2*x₂^4 + 96*x₁^2*x₂*y₁*y₂
      - 480*x₁^2*x₂*y₂^2 - 768*x₁*x₂^5 + 96*x₁*x₂^2*y₁^2 - 192*x₁*x₂^2*y₁*y₂
      + 480*x₁*x₂^2*y₂^2 - 64*x₂^3*y₁*y₂ - 64*x₂^3*y₂^2 + 8*y₁^3*y₂ - 16*y₁^2*y₂^2
      + 16*y₂^4) * hP +
    (-40*g₂^2*x₁^2 + 24*g₂^2*x₁*x₂ - 8*g₂^2*x₂^2 - 56*g₂*g₃*x₁ + 8*g₂*g₃*x₂ + 32*g₂*x₁^4
      + 448*g₂*x₁^3*x₂ - 288*g₂*x₁^2*x₂^2 - 40*g₂*x₁*y₁*y₂ + 8*g₂*x₂*y₂^2 - 24*g₃^2
      - 192*g₃*x₁^3 + 864*g₃*x₁^2*x₂ - 480*g₃*x₁*x₂^2 - 40*g₃*y₁*y₂ + 8*g₃*y₂^2
      - 1152*x₁^5*x₂ + 768*x₁^4*x₂^2 + 64*x₁^3*y₁*y₂ + 64*x₁^3*y₂^2 + 192*x₁^2*x₂*y₁*y₂
      - 96*x₁^2*x₂*y₂^2 - 96*x₁*x₂^2*y₁*y₂ - 8*y₁*y₂^3) * hQ

include hP hQ in
theorem affK1₁VV :
    (x₁ - x₂) *
      (kapW₁VV g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 +
        2 * y₂ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₁ ^ 2) +
        2 * y₁ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₂ ^ 2)) =
      y₁ * y₂ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (y₁ - y₂) := by
  linear_combination (norm := (simp only [kapW₁VV, law₁W]; ring))
    (-g₂*x₁*y₂ + 2*g₂*x₂*y₂ + g₃*y₂ + 12*x₁^2*x₂*y₂ - 24*x₁*x₂^2*y₂ + 8*x₂^3*y₂ - y₁^2*y₂
      + y₁*y₂^2 + y₂^3) * hP +
    (g₂*x₁*y₁ - g₂*x₁*y₂ - g₂*x₂*y₁ - g₃*y₂ + 12*x₁^3*y₁ + 4*x₁^3*y₂ - 24*x₁^2*x₂*y₁
      + 12*x₁*x₂^2*y₁ - y₁*y₂^2) * hQ

include hP hQ in
theorem affK3₁VV :
    16 * (x₁ - x₂) ^ 4 *
      (kapV₁VV g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 +
        2 * y₂ * law₁V g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₁ ^ 2) +
        2 * y₁ * law₁V g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₂ ^ 2)) =
      y₁ * y₂ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 *
        (2 * affY3 x₁ y₁ x₂ y₂ * (y₁ - y₂) + 4 * affN3 x₁ y₁ x₂ y₂ ^ 2) := by
  linear_combination (norm := (simp only [kapV₁VV, law₁V, law₁W, affY3, affN3]; ring))
    (-32*g₂^2*x₁^4*x₂ + 128*g₂^2*x₁^3*x₂^2 - 192*g₂^2*x₁^2*x₂^3 + 128*g₂^2*x₁*x₂^4
      - 32*g₂^2*x₂^5 - 32*g₂*g₃*x₁^4 + 128*g₂*g₃*x₁^3*x₂ - 192*g₂*g₃*x₁^2*x₂^2
      + 128*g₂*g₃*x₁*x₂^3 - 32*g₂*g₃*x₂^4 + 192*g₂*x₁^5*x₂^2 - 640*g₂*x₁^4*x₂^3
      + 640*g₂*x₁^3*x₂^4 - 16*g₂*x₁^3*x₂*y₁*y₂ + 16*g₂*x₁^3*x₂*y₂^2
      + 32*g₂*x₁^2*x₂^2*y₁*y₂ - 16*g₂*x₁^2*x₂^2*y₂^2 - 320*g₂*x₁*x₂^6
      - 16*g₂*x₁*x₂^3*y₁*y₂ - 16*g₂*x₁*x₂^3*y₂^2 + 128*g₂*x₂^7 + 16*g₂*x₂^4*y₂^2
      + 192*g₃*x₁^5*x₂ - 768*g₃*x₁^4*x₂^2 + 1152*g₃*x₁^3*x₂^3 - 16*g₃*x₁^3*y₁*y₂
      + 16*g₃*x₁^3*y₂^2 - 768*g₃*x₁^2*x₂^4 + 32*g₃*x₁^2*x₂*y₁*y₂ - 16*g₃*x₁^2*x₂*y₂^2
      + 192*g₃*x₁*x₂^5 - 16*g₃*x₁*x₂^2*y₁*y₂ - 16*g₃*x₁*x₂^2*y₂^2 + 16*g₃*x₂^3*y₂^2
      - 768*x₁^5*x₂^4 - 192*x₁^5*x₂*y₁*y₂ + 3072*x₁^4*x₂^5 + 768*x₁^4*x₂^2*y₁*y₂
      - 4608*x₁^3*x₂^6 - 1088*x₁^3*x₂^3*y₁*y₂ - 64*x₁^3*x₂^3*y₂^2 + 16*x₁^3*y₁^3*y₂
      - 16*x₁^3*y₁^2*y₂^2 - 16*x₁^3*y₁*y₂^3 + 16*x₁^3*y₂^4 + 3072*x₁^2*x₂^7
      + 640*x₁^2*x₂^4*y₁*y₂ + 64*x₁^2*x₂^4*y₂^2 - 32*x₁^2*x₂*y₁^3*y₂
      + 16*x₁^2*x₂*y₁^2*y₂^2 + 48*x₁^2*x₂*y₁*y₂^3 - 16*x₁^2*x₂*y₂^4 - 768*x₁*x₂^8
      - 128*x₁*x₂^5*y₁*y₂ + 64*x₁*x₂^5*y₂^2 + 16*x₁*x₂^2*y₁^3*y₂ + 16*x₁*x₂^2*y₁^2*y₂^2
      - 48*x₁*x₂^2*y₁*y₂^3 - 16*x₁*x₂^2*y₂^4 - 64*x₂^6*y₂^2 - 16*x₂^3*y₁^2*y₂^2
      + 16*x₂^3*y₁*y₂^3 + 16*x₂^3*y₂^4) * hP +
    (32*g₂^2*x₁^5 - 128*g₂^2*x₁^4*x₂ + 192*g₂^2*x₁^3*x₂^2 - 128*g₂^2*x₁^2*x₂^3
      + 32*g₂^2*x₁*x₂^4 + 32*g₂*g₃*x₁^4 - 128*g₂*g₃*x₁^3*x₂ + 192*g₂*g₃*x₁^2*x₂^2
      - 128*g₂*g₃*x₁*x₂^3 + 32*g₂*g₃*x₂^4 - 128*g₂*x₁^7 + 320*g₂*x₁^6*x₂
      - 640*g₂*x₁^4*x₂^3 + 16*g₂*x₁^4*y₁*y₂ - 16*g₂*x₁^4*y₂^2 + 640*g₂*x₁^3*x₂^4
      - 32*g₂*x₁^3*x₂*y₁*y₂ + 16*g₂*x₁^3*x₂*y₂^2 - 192*g₂*x₁^2*x₂^5
      + 16*g₂*x₁^2*x₂^2*y₁*y₂ + 16*g₂*x₁^2*x₂^2*y₂^2 - 16*g₂*x₁*x₂^3*y₂^2 - 192*g₃*x₁^5*x₂
      + 768*g₃*x₁^4*x₂^2 - 1152*g₃*x₁^3*x₂^3 + 16*g₃*x₁^3*y₁*y₂ - 16*g₃*x₁^3*y₂^2
      + 768*g₃*x₁^2*x₂^4 - 32*g₃*x₁^2*x₂*y₁*y₂ + 16*g₃*x₁^2*x₂*y₂^2 - 192*g₃*x₁*x₂^5
      + 16*g₃*x₁*x₂^2*y₁*y₂ + 16*g₃*x₁*x₂^2*y₂^2 - 16*g₃*x₂^3*y₂^2 + 768*x₁^8*x₂
      - 3072*x₁^7*x₂^2 + 4608*x₁^6*x₂^3 - 64*x₁^6*y₁*y₂ + 64*x₁^6*y₂^2 - 3072*x₁^5*x₂^4
      + 320*x₁^5*x₂*y₁*y₂ - 64*x₁^5*x₂*y₂^2 + 768*x₁^4*x₂^5 - 832*x₁^4*x₂^2*y₁*y₂
      - 64*x₁^4*x₂^2*y₂^2 + 1152*x₁^3*x₂^3*y₁*y₂ + 64*x₁^3*x₂^3*y₂^2 - 768*x₁^2*x₂^4*y₁*y₂
      - 16*x₁^2*x₂*y₁*y₂^3 + 192*x₁*x₂^5*y₁*y₂ + 32*x₁*x₂^2*y₁*y₂^3 - 16*x₂^3*y₁*y₂^3) * hQ

include hP hQ in
theorem affK1₁VW :
    (x₁ - x₂) *
      (kapW₁VW g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 +
        2 * 1 * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₁ ^ 2) +
        2 * y₁ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * 0) =
      y₁ * 1 * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (y₁ - y₂) := by
  linear_combination (norm := (simp only [kapW₁VW, law₁W]; ring))
    (-g₂*x₁ + 2*g₂*x₂ + g₃ + 12*x₁^2*x₂ - 24*x₁*x₂^2 + 8*x₂^3 - y₁^2 + y₁*y₂ + y₂^2) * hP +
    (-g₂*x₁ - g₃ + 4*x₁^3 - y₁*y₂) * hQ

include hP hQ in
theorem affK3₁VW :
    16 * (x₁ - x₂) ^ 4 *
      (kapV₁VW g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 +
        2 * 1 * law₁V g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₁ ^ 2) +
        2 * y₁ * law₁V g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * 0) =
      y₁ * 1 * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 *
        (2 * affY3 x₁ y₁ x₂ y₂ * (y₁ - y₂) + 4 * affN3 x₁ y₁ x₂ y₂ ^ 2) := by
  linear_combination (norm := (simp only [kapV₁VW, law₁V, law₁W, affY3, affN3]; ring))
    (32*g₂*x₁^4*y₂ - 16*g₂*x₁^3*x₂*y₁ - 112*g₂*x₁^3*x₂*y₂ + 32*g₂*x₁^2*x₂^2*y₁
      + 176*g₂*x₁^2*x₂^2*y₂ - 16*g₂*x₁*x₂^3*y₁ - 144*g₂*x₁*x₂^3*y₂ + 48*g₂*x₂^4*y₂
      - 16*g₃*x₁^3*y₁ + 16*g₃*x₁^3*y₂ + 32*g₃*x₁^2*x₂*y₁ - 16*g₃*x₁^2*x₂*y₂
      - 16*g₃*x₁*x₂^2*y₁ - 16*g₃*x₁*x₂^2*y₂ + 16*g₃*x₂^3*y₂ - 192*x₁^5*x₂*y₁
      - 192*x₁^5*x₂*y₂ + 768*x₁^4*x₂^2*y₁ + 768*x₁^4*x₂^2*y₂ - 1088*x₁^3*x₂^3*y₁
      - 1216*x₁^3*x₂^3*y₂ + 16*x₁^3*y₁^3 - 16*x₁^3*y₁^2*y₂ - 16*x₁^3*y₁*y₂^2
      + 16*x₁^3*y₂^3 + 640*x₁^2*x₂^4*y₁ + 832*x₁^2*x₂^4*y₂ - 32*x₁^2*x₂*y₁^3
      + 16*x₁^2*x₂*y₁^2*y₂ + 48*x₁^2*x₂*y₁*y₂^2 - 16*x₁^2*x₂*y₂^3 - 128*x₁*x₂^5*y₁
      - 128*x₁*x₂^5*y₂ + 16*x₁*x₂^2*y₁^3 + 16*x₁*x₂^2*y₁^2*y₂ - 48*x₁*x₂^2*y₁*y₂^2
      - 16*x₁*x₂^2*y₂^3 - 64*x₂^6*y₂ - 16*x₂^3*y₁^2*y₂ + 16*x₂^3*y₁*y₂^2 + 16*x₂^3*y₂^3) * hP +
    (-16*g₂*x₁^4*y₂ + 32*g₂*x₁^3*x₂*y₁ + 16*g₂*x₁^3*x₂*y₂ - 80*g₂*x₁^2*x₂^2*y₁
      + 16*g₂*x₁^2*x₂^2*y₂ + 64*g₂*x₁*x₂^3*y₁ - 16*g₂*x₁*x₂^3*y₂ - 16*g₂*x₂^4*y₁
      + 16*g₃*x₁^3*y₁ - 16*g₃*x₁^3*y₂ - 32*g₃*x₁^2*x₂*y₁ + 16*g₃*x₁^2*x₂*y₂
      + 16*g₃*x₁*x₂^2*y₁ + 16*g₃*x₁*x₂^2*y₂ - 16*g₃*x₂^3*y₂ + 128*x₁^6*y₁ + 64*x₁^6*y₂
      - 448*x₁^5*x₂*y₁ - 64*x₁^5*x₂*y₂ + 320*x₁^4*x₂^2*y₁ - 64*x₁^4*x₂^2*y₂
      + 384*x₁^3*x₂^3*y₁ + 64*x₁^3*x₂^3*y₂ - 576*x₁^2*x₂^4*y₁ - 16*x₁^2*x₂*y₁*y₂^2
      + 192*x₁*x₂^5*y₁ + 32*x₁*x₂^2*y₁*y₂^2 - 16*x₂^3*y₁*y₂^2) * hQ

include hP hQ in
theorem affK1₁WV :
    (x₁ - x₂) *
      (kapW₁WV g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 +
        2 * y₂ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * 0 +
        2 * 1 * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (2 * x₂ ^ 2)) =
      1 * y₂ * law₁W g₂ g₃ x₁ y₁ 1 x₂ y₂ 1 * (y₁ - y₂) := by
