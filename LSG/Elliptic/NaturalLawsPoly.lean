      - 384*V₂^3*W₁^2*W₂^2*g₂*g₃ - 432*V₂*W₁^2*W₂^4*g₂*g₃^2) * F g₂ g₃ U₁ V₁ W₁ +
    (192*U₁^2*U₂*V₁^2*V₂*W₁*g₂ + 1728*U₁^2*U₂*V₁*W₁^2*W₂*g₂*g₃
      + 1728*U₁^2*U₂*V₂*W₁^3*g₂*g₃ + 576*U₁^2*V₁*V₂^2*W₁^2*g₃
      + 32*U₁^2*V₁*W₁^2*W₂^2*g₂^3 + 1728*U₁^2*V₁*W₁^2*W₂^2*g₃^2
      + 112*U₁^2*V₂*W₁^3*W₂*g₂^3 + 3456*U₁^2*V₂*W₁^3*W₂*g₃^2
      + 576*U₁*U₂*V₁^2*V₂*W₁^2*g₃ + 64*U₁*U₂*V₁*W₁^3*W₂*g₂^3
      + 3456*U₁*U₂*V₁*W₁^3*W₂*g₃^2 + 128*U₁*U₂*V₂*W₁^4*g₂^3
      + 1728*U₁*U₂*V₂*W₁^4*g₃^2 + 48*U₁*V₁^2*V₂*W₁^2*W₂*g₂^2
      + 64*U₁*V₁*V₂^2*W₁^3*g₂^2 + 288*U₁*V₁*W₁^3*W₂^2*g₂^2*g₃
      + 720*U₁*V₂*W₁^4*W₂*g₂^2*g₃ + 96*U₂*V₁^3*W₁^2*W₂*g₂^2
