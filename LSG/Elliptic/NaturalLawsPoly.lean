theorem phi₂WV (g₂ g₃ U₁ V₁ W₁ U₂ V₂ W₂ : R) :
    law₂V g₂ g₃ U₁ V₁ W₁ U₂ V₂ W₂ * kapW₂WV g₂ g₃ U₁ V₁ W₁ U₂ V₂ W₂ -
