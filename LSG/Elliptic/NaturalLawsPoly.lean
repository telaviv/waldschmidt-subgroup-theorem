      + 1152*U₂^2*V₁*V₂^2*W₁*W₂*g₃ - 96*U₂^2*V₁*W₁*W₂^3*g₂^3
      + 576*U₂^2*V₂^3*W₁^2*g₃ - 96*U₂^2*V₂*W₁^2*W₂^2*g₂^3
      - 64*U₂*V₁*V₂^2*W₁*W₂^2*g₂^2 - 240*U₂*V₁*W₁*W₂^4*g₂^2*g₃
      - 32*U₂*V₂^3*W₁^2*W₂*g₂^2 - 528*U₂*V₂*W₁^2*W₂^3*g₂^2*g₃
      - 16*V₁^2*V₂^3*W₂^2*g₂ - 64*V₁*V₂^4*W₁*W₂*g₂
