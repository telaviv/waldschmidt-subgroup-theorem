import Mathlib
import LSG.ME.Geom
import LSG.ME.IGPrime

/-!
# The ideal `I_G` of `G = G_a^{d₀} × G_m^{d₁} × E₁ × ⋯ × E_m`

`I_G = (Y_j Z_j − 1, F_k)`, `F_k` the cone form of the `k`-th elliptic factor.

* `lG`, `IG`: the generators (as a list, for StrongSix's `bezout`) and the ideal.
* **`IG_isPrime`**: `I_G` is prime (any field with `2 ≠ 0`; more generally every `IGsub T₁ T₂`,
  generated by a subset of the generators, is prime). Proof: `K[Var] ≃ K[X][Y, Z][U, V, W]`,
  then `LSG.ME.isPrime_span_gensProd` twice (blocks `Y Z − 1`, then blocks `F_k`).
* **`height_IG`**: `(Ideal.ofList lG).height = lG.length` (a complete intersection): `≥` by the
  chain of primes `IGsub` along the list, `≤` by Krull's height theorem.
* **`vanish_univ`**: `vanish univ = I_G` for `K` algebraically closed (Hilbert's Nullstellensatz,
  the density argument `eval_coordsZ_eq_zero` for zero cone vectors, and primality).
-/

universe u

open MvPolynomial LSG.Elliptic

namespace LSG.ME

variable {K : Type u} [Field K] {d₀ d₁ m : ℕ} (g₂ g₃ : Fin m → K)

/-- `Y_j Z_j − 1`. -/
noncomputable def YZ (K : Type u) [Field K] (d₀ : ℕ) {d₁ : ℕ} (m : ℕ) (j : Fin d₁) :
    MvPolynomial (Var d₀ d₁ m) K :=
  X (.y j) * X (.z j) - 1

/-- The cone form of the `k`-th elliptic factor. -/
noncomputable def Fk (d₀ d₁ : ℕ) (k : Fin m) : MvPolynomial (Var d₀ d₁ m) K :=
  F (C (g₂ k)) (C (g₃ k)) (X (.e k 0)) (X (.e k 1)) (X (.e k 2))

/-- The generators of `I_G`, as a list. -/
noncomputable def lG : List (MvPolynomial (Var d₀ d₁ m) K) :=
  List.ofFn (YZ K d₀ m) ++ List.ofFn (Fk g₂ g₃ d₀ d₁)

/-- The ideal `I_G`. -/
noncomputable def IG : Ideal (MvPolynomial (Var d₀ d₁ m) K) := Ideal.ofList (lG (d₀ := d₀) (d₁ :=
    d₁) g₂ g₃)

/-- The ideal generated by some of the generators. -/
noncomputable def IGsub (T₁ : Set (Fin d₁)) (T₂ : Set (Fin m)) : Ideal (MvPolynomial (Var d₀ d₁ m)
    K) :=
  Ideal.span (YZ K d₀ m '' T₁ ∪ Fk g₂ g₃ d₀ d₁ '' T₂)

theorem lG_length : (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃).length = d₁ + m := by simp [lG]

theorem IG_eq_IGsub : IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ = IGsub g₂ g₃ Set.univ Set.univ := by
  rw [IG, IGsub, Ideal.ofList]
  congr 1
  ext P
  simp [lG]

theorem YZ_mem_IG (j : Fin d₁) : YZ K d₀ m j ∈ IG (d₀ := d₀) g₂ g₃ :=
  Ideal.subset_span (by simp [lG])

theorem Fk_mem_IG (k : Fin m) : Fk g₂ g₃ d₀ d₁ k ∈ IG (d₀ := d₀) g₂ g₃ :=
  Ideal.subset_span (by simp [lG])

/-! ### Primality -/

section Prime

/-- `Var d₀ d₁ m ≃ (Fin m × Fin 3) ⊕ ((Fin d₁ × Fin 2) ⊕ Fin d₀)`. -/
def varEquiv (d₀ d₁ m : ℕ) : Var d₀ d₁ m ≃ (Fin m × Fin 3) ⊕ ((Fin d₁ × Fin 2) ⊕ Fin d₀) where
  toFun
    | .x i => .inr (.inr i)
    | .y j => .inr (.inl (j, 0))
    | .z j => .inr (.inl (j, 1))
    | .e k c => .inl (k, c)
  invFun
    | .inl (k, c) => .e k c
    | .inr (.inl (j, c)) => if c = 0 then .y j else .z j
    | .inr (.inr i) => .x i
  left_inv v := by cases v <;> simp
  right_inv v := by
    rcases v with ⟨k, c⟩ | ⟨j, c⟩ | i
    · rfl
    · fin_cases c <;> rfl
    · rfl

local notation "R₀" => MvPolynomial (Fin d₀) K
local notation "S₁" => MvPolynomial (Fin d₁ × Fin 2) (MvPolynomial (Fin d₀) K)

/-- `K[Var] ≃ K[X][Y, Z][U, V, W]`. -/
noncomputable def Θ (K : Type u) [Field K] (d₀ d₁ m : ℕ) :
    MvPolynomial (Var d₀ d₁ m) K ≃ₐ[K]
      MvPolynomial (Fin m × Fin 3) (MvPolynomial (Fin d₁ × Fin 2) (MvPolynomial (Fin d₀) K)) :=
  (renameEquiv K (varEquiv d₀ d₁ m)).trans ((sumAlgEquiv K _ _).trans
    (mapAlgEquiv _ (sumAlgEquiv K _ _)))

theorem Θ_C (a : K) : Θ K d₀ d₁ m (C a) = C (C (C a)) := by
  simp [Θ, sumAlgEquiv_C_inl]

theorem Θ_y (j : Fin d₁) : Θ K d₀ d₁ m (X (.y j)) = C (X (j, 0)) := by
  simp [Θ, varEquiv, sumAlgEquiv_X_inr, sumAlgEquiv_X_inl]

theorem Θ_z (j : Fin d₁) : Θ K d₀ d₁ m (X (.z j)) = C (X (j, 1)) := by
  simp [Θ, varEquiv, sumAlgEquiv_X_inr, sumAlgEquiv_X_inl]

theorem Θ_e (k : Fin m) (c : Fin 3) : Θ K d₀ d₁ m (X (.e k c)) = X (k, c) := by
  simp [Θ, varEquiv, sumAlgEquiv_X_inl]

open Classical in
/-- The `G_m` relations, `0` outside `T₁`. -/
noncomputable def rT (T₁ : Set (Fin d₁)) : Fin d₁ → MvPolynomial (Fin 2) K :=
  fun j => if j ∈ T₁ then X 0 * X 1 - 1 else 0

open Classical in
/-- The elliptic relations, `0` outside `T₂`. -/
noncomputable def rE (T₂ : Set (Fin m)) : Fin m → MvPolynomial (Fin 3) K :=
  fun k => if k ∈ T₂ then Fcone K (g₂ k) (g₃ k) else 0

theorem hP_YZ : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra K R] (f : MvPolynomial (Fin 2) K),
    (f = X 0 * X 1 - 1 ∨ f = 0) → (Ideal.span {map (algebraMap K R) f}).IsPrime := by
  intro R _ _ _ f hf
  rcases hf with rfl | rfl
  · simpa using isPrime_span_YZ (R := R)
  · simpa using Ideal.isPrime_bot

theorem hP_F (h2 : (2 : K) ≠ 0) :
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra K R] (f : MvPolynomial (Fin 3) K),
      ((∃ a b : K, f = Fcone K a b) ∨ f = 0) → (Ideal.span {map (algebraMap K R) f}).IsPrime := by
  intro R _ _ _ f hf
  rcases hf with ⟨a, b, rfl⟩ | rfl
  · have : map (algebraMap K R) (Fcone K a b) = Fcone R (algebraMap K R a) (algebraMap K R b) := by
      simp [Fcone, F]
    rw [this]
    exact isPrime_span_F h2 _ _
  · simpa using Ideal.isPrime_bot

theorem Θ_YZ (j : Fin d₁) :
    Θ K d₀ d₁ m (YZ K d₀ m j) =
      C (rename (Prod.mk j) (map (algebraMap K R₀) (X 0 * X 1 - 1 : MvPolynomial (Fin 2) K))) := by
  simp [YZ, Θ_y, Θ_z]

theorem Θ_Fk (k : Fin m) :
    Θ K d₀ d₁ m (Fk g₂ g₃ d₀ d₁ k) =
      rename (Prod.mk k) (map (algebraMap K S₁) (Fcone K (g₂ k) (g₃ k))) := by
  simp [Fk, Fcone, F, Θ_e, Θ_C, MvPolynomial.algebraMap_apply, map_ofNat]

set_option maxSynthPendingDepth 10 in
/-- **Every `IGsub` is prime** (in particular `I_G`). -/
theorem IGsub_isPrime (h2 : (2 : K) ≠ 0) (T₁ : Set (Fin d₁)) (T₂ : Set (Fin m)) :
    (IGsub (d₀ := d₀) g₂ g₃ T₁ T₂).IsPrime := by
  classical
  set JT : Ideal S₁ := Ideal.span (gensProd R₀ (rT (K := K) T₁)) with hJT
  have hJ : JT.IsPrime := isPrime_span_gensProd (K := K) _ (hP_YZ (K := K)) d₁ (rT (K := K) T₁)
    (fun j => by unfold rT; split_ifs <;> simp) R₀
  set ψ : MvPolynomial (Fin m × Fin 3) S₁ →+* MvPolynomial (Fin m × Fin 3) (S₁ ⧸ JT) :=
    map (Ideal.Quotient.mk JT)
  have hψ : Function.Surjective ψ := map_surjective _ Ideal.Quotient.mk_surjective
  -- the image of `IGsub` under `Θ`
  have himg : (IGsub (d₀ := d₀) g₂ g₃ T₁ T₂).map (Θ K d₀ d₁ m).toRingEquiv =
      Ideal.span (C '' gensProd R₀ (rT (K := K) T₁) ∪ gensProd S₁ (rE g₂ g₃ T₂)) := by
    rw [IGsub, Ideal.map_span]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨P, hP | hP, rfl⟩
      · obtain ⟨j, hj, rfl⟩ := hP
        refine Ideal.subset_span (Or.inl ⟨_, ⟨j, rfl⟩, ?_⟩)
        change _ = Θ K d₀ d₁ m (YZ K d₀ m j)
        simp only [Θ_YZ, rT, hj, ite_true]
      · obtain ⟨k, hk, rfl⟩ := hP
        refine Ideal.subset_span (Or.inr ⟨k, ?_⟩)
        change _ = Θ K d₀ d₁ m (Fk g₂ g₃ d₀ d₁ k)
        simp only [Θ_Fk, rE, hk, ite_true]
    · rw [Ideal.span_le]
      rintro _ (⟨_, ⟨j, rfl⟩, rfl⟩ | ⟨k, rfl⟩)
      · by_cases hj : j ∈ T₁
        · refine Ideal.subset_span ⟨YZ K d₀ m j, Or.inl ⟨j, hj, rfl⟩, ?_⟩
          change Θ K d₀ d₁ m (YZ K d₀ m j) = _
          simp only [Θ_YZ, rT, hj, ite_true]
        · simp only [rT, hj, ite_false, map_zero, SetLike.mem_coe]
          exact Ideal.zero_mem _
      · by_cases hk : k ∈ T₂
        · refine Ideal.subset_span ⟨Fk g₂ g₃ d₀ d₁ k, Or.inr ⟨k, hk, rfl⟩, ?_⟩
          change Θ K d₀ d₁ m (Fk g₂ g₃ d₀ d₁ k) = _
          simp only [Θ_Fk, rE, hk, ite_true]
        · simp only [rE, hk, ite_false, map_zero, SetLike.mem_coe]
          exact Ideal.zero_mem _
  apply isPrime_of_map_equiv (Θ K d₀ d₁ m).toRingEquiv
  rw [himg]
  refine isPrime_of_map_surj ψ hψ _ ?_ ?_
  · rw [ker_map, Ideal.mk_ker, hJT, Ideal.map_span]
    exact Ideal.span_mono Set.subset_union_left
  · have halg : algebraMap K (S₁ ⧸ JT) = (Ideal.Quotient.mk JT).comp (algebraMap K S₁) := by
      ext x; rfl
    have : (Ideal.span (C '' gensProd R₀ (rT (K := K) T₁) ∪ gensProd S₁ (rE g₂ g₃ T₂))).map ψ =
        Ideal.span (gensProd (S₁ ⧸ JT) (rE g₂ g₃ T₂)) := by
      rw [Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, (⟨x, hx, rfl⟩ | ⟨k, rfl⟩), rfl⟩
        · have : ψ (C x) = 0 := by
            simp only [ψ, map_C, C_eq_zero]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hx)
          rw [SetLike.mem_coe, this]
          exact Ideal.zero_mem _
        · refine Ideal.subset_span ⟨k, ?_⟩
          simp only [ψ, map_rename, map_map, halg]
      · rw [Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        refine Ideal.subset_span ⟨_, Or.inr ⟨k, rfl⟩, ?_⟩
        simp only [ψ, map_rename, map_map, halg]
    rw [this]
    exact isPrime_span_gensProd (K := K) _ (hP_F (K := K) h2) m (rE g₂ g₃ T₂)
      (fun k => by unfold rE; split_ifs <;> simp) _

/-- **`I_G` is prime.** -/
theorem IG_isPrime (h2 : (2 : K) ≠ 0) : (IG (d₀ := d₀) (d₁ := d₁) g₂ g₃).IsPrime := by
  rw [IG_eq_IGsub]; exact IGsub_isPrime g₂ g₃ h2 _ _

end Prime

/-! ### Height -/

section Height

/-- The `s`-th ideal of the chain: the first `s` generators of `lG`. -/
noncomputable def Jc (d₀ d₁ : ℕ) (s : ℕ) : Ideal (MvPolynomial (Var d₀ d₁ m) K) :=
  IGsub (d₀ := d₀) g₂ g₃ {j | j.val < s} {k | d₁ + k.val < s}

theorem Jc_mono (s : ℕ) : Jc g₂ g₃ d₀ d₁ s ≤ Jc g₂ g₃ d₀ d₁ (s + 1) := by
  apply Ideal.span_mono
  apply Set.union_subset_union <;> apply Set.image_mono <;> intro x hx <;>
    simp only [Set.mem_ofPred_eq] at hx ⊢ <;> omega

/-- An ideal whose generators vanish at `x` vanishes at `x`. -/
theorem eval_eq_zero_of_span {s : Set (MvPolynomial (Var d₀ d₁ m) K)} {x : Var d₀ d₁ m → K}
    (hs : ∀ P ∈ s, eval x P = 0) {P : MvPolynomial (Var d₀ d₁ m) K} (hP : P ∈ Ideal.span s) :
    eval x P = 0 := by
  have : Ideal.span s ≤ RingHom.ker (eval x) := Ideal.span_le.mpr fun P hP => hs P hP
  exact this hP

theorem Jc_lt (h2 : (2 : K) ≠ 0) {s : ℕ} (hs : s < d₁ + m) :
    Jc g₂ g₃ d₀ d₁ s < Jc g₂ g₃ d₀ d₁ (s + 1) := by
  classical
  refine lt_of_le_of_ne (Jc_mono g₂ g₃ s) fun heq => ?_
  by_cases hs1 : s < d₁
  · -- the new generator `Y_s Z_s − 1`
    set j₀ : Fin d₁ := ⟨s, hs1⟩
    let x : Var d₀ d₁ m → K := fun v => match v with
      | .x _ => 0
      | .y j => if j = j₀ then 0 else 1
      | .z j => if j = j₀ then 0 else 1
      | .e _ _ => 0
    have hmem : YZ K d₀ m j₀ ∈ Jc g₂ g₃ d₀ d₁ (s + 1) :=
      Ideal.subset_span (Or.inl ⟨j₀, by simp [j₀], rfl⟩)
    rw [← heq] at hmem
    have := eval_eq_zero_of_span (x := x) ?_ hmem
    · simp [YZ, x] at this
    · rintro _ (⟨j, hj, rfl⟩ | ⟨k, hk, rfl⟩)
      · have : j ≠ j₀ := fun h => by
          simp only [Set.mem_ofPred_eq] at hj; rw [h] at hj; simp [j₀] at hj
        simp [YZ, x, this]
      · simp only [Set.mem_ofPred_eq] at hk; omega
  · -- the new generator `F_{s − d₁}`
    set k₀ : Fin m := ⟨s - d₁, by omega⟩
    let x : Var d₀ d₁ m → K := fun v => match v with
      | .x _ => 0
      | .y _ => 1
      | .z _ => 1
      | .e k c => if k = k₀ ∧ c = 0 then 1 else 0
    have hmem : Fk g₂ g₃ d₀ d₁ k₀ ∈ Jc g₂ g₃ d₀ d₁ (s + 1) :=
      Ideal.subset_span (Or.inr ⟨k₀, by simp [k₀]; omega, rfl⟩)
    rw [← heq] at hmem
    have := eval_eq_zero_of_span (x := x) ?_ hmem
    · have hv : eval x (Fk g₂ g₃ d₀ d₁ k₀) = -(2 * 2) := by
        simp [Fk, F, x]; norm_num
      rw [hv, neg_eq_zero] at this
      exact h2 (mul_self_eq_zero.mp this)
    · rintro _ (⟨j, hj, rfl⟩ | ⟨k, hk, rfl⟩)
      · simp [YZ, x]
      · have : k ≠ k₀ := fun h => by
          simp only [Set.mem_ofPred_eq] at hk; rw [h] at hk; simp [k₀] at hk; omega
        simp [Fk, F, x, this]

theorem Jc_top : Jc g₂ g₃ d₀ d₁ (d₁ + m) = IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ := by
  rw [IG_eq_IGsub, Jc, IGsub]
  congr 3
  · ext j; simp only [Set.mem_ofPred_eq, Set.mem_univ, iff_true]; omega
  · ext k; simp only [Set.mem_ofPred_eq, Set.mem_univ, iff_true]; omega

theorem le_height_Jc (h2 : (2 : K) ≠ 0) :
    ∀ s ≤ d₁ + m, (s : ℕ∞) ≤ (Jc g₂ g₃ d₀ d₁ s).height := by
  intro s
  induction s with
  | zero => intro _; simp
  | succ s ih =>
    intro hs
    have : (Jc g₂ g₃ d₀ d₁ s).IsPrime := IGsub_isPrime g₂ g₃ h2 _ _
    have : (Jc g₂ g₃ d₀ d₁ (s + 1)).IsPrime := IGsub_isPrime g₂ g₃ h2 _ _
    have h := Ideal.height_add_one_le_of_lt_of_isPrime (Jc_lt g₂ g₃ h2 (d₀ := d₀) (by omega : s <
        d₁ + m))
    push_cast
    exact le_trans (by gcongr; exact ih (by omega)) h

/-- **`I_G` is a complete intersection**: `ht I_G = d₁ + m = length lG`. -/
theorem height_IG (h2 : (2 : K) ≠ 0) :
    (Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃)).height =
      (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃).length := by
  classical
  rw [lG_length]
  apply le_antisymm
  · have hne : Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃) ≠ ⊤ := (IG_isPrime g₂ g₃ h2).ne_top
    have hspan : Ideal.ofList (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃) =
        Ideal.span ((lG (d₀ := d₀) (d₁ := d₁) g₂ g₃).toFinset : Set _) := by
      rw [List.coe_toFinset]
    rw [hspan] at hne ⊢
    refine (Ideal.height_span_le_card_of_span_ne_top hne).trans ?_
    have := List.toFinset_card_le (lG (d₀ := d₀) (d₁ := d₁) g₂ g₃)
    rw [lG_length] at this
    exact_mod_cast this
  · have := le_height_Jc g₂ g₃ (d₀ := d₀) h2 (d₁ + m) le_rfl
    rw [Jc_top] at this
    exact_mod_cast this

end Height

/-! ### The Nullstellensatz on `G` -/

section Null

variable {g₂ g₃}

theorem IG_le_vanish (h2 : (2 : K) ≠ 0) (E : Set (GPt K d₀ d₁ g₂ g₃)) :
    IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ ≤ vanish E := by
  rw [IG, Ideal.ofList, Ideal.span_le]
  intro P hP
  simp only [lG, List.mem_append, List.mem_ofFn, Set.mem_ofPred_eq] at hP
  refine mem_vanish.mpr fun g _ lam => ?_
  rcases hP with ⟨j, rfl⟩ | ⟨k, rfl⟩
  · simp [YZ, coords]
  · have h := Fv_rep h2 (g.2.2 k)
    simp only [Fv, F] at h
    simp only [Fk, F, map_add, map_sub, map_mul, map_pow, eval_C, eval_X, coords, coordsZ_e,
      map_ofNat]
    linear_combination (lam k : K) ^ 3 * h

variable (hΔ : ∀ k, g₂ k ^ 3 - 27 * g₃ k ^ 2 ≠ 0)
include hΔ

/-- **Hilbert's Nullstellensatz on `G`**: `I(G) = I_G` (`K` algebraically closed). -/
theorem vanish_univ [IsAlgClosed K] (h2 : (2 : K) ≠ 0) :
    vanish (Set.univ : Set (GPt K d₀ d₁ g₂ g₃)) = IG (d₀ := d₀) (d₁ := d₁) g₂ g₃ := by
  classical
  apply le_antisymm _ (IG_le_vanish h2 _)
  intro P hP
  have hprime := IG_isPrime (d₀ := d₀) (d₁ := d₁) g₂ g₃ h2
  rw [← hprime.radical, ← vanishingIdeal_zeroLocus_eq_radical (K := K), mem_vanishingIdeal_iff]
  intro x hx
  rw [mem_zeroLocus_iff] at hx
  rw [show (aeval x) P = eval x P from rfl]
  have hyz : ∀ j, x (.y j) * x (.z j) = 1 := fun j => by
    have := hx _ (YZ_mem_IG g₂ g₃ j)
    rw [show (aeval x) _ = eval x _ from rfl] at this
    simpa [YZ, sub_eq_zero] using this
  set cv : Fin m → Fin 3 → K := fun k c => x (.e k c)
  have hF : ∀ k, Fv (g₂ k) (g₃ k) (cv k) = 0 := fun k => by
    have := hx _ (Fk_mem_IG g₂ g₃ k)
    rw [show (aeval x) _ = eval x _ from rfl] at this
    simpa [Fk, F, Fv, cv] using this
  let g : GPt K d₀ d₁ g₂ g₃ := (fun i => x (.x i),
    Additive.ofMul fun j => Units.mkOfMulEqOne _ _ (hyz j), fun k => toPoint (g₂ k) (g₃ k) (cv k))
  let ν : Fin m → K := fun k => if h : cv k = 0 then 0 else
    Classical.choose (exists_smul_rep h2 (hΔ k) (hF k) h)
  have hx' : x = coordsZ g ν := by
    funext v
    cases v with
    | x i => rfl
    | y j => rfl
    | z j => rfl
    | e k c =>
      by_cases h : cv k = 0
      · have : x (.e k c) = 0 := congrFun h c
        simp [ν, h, this]
      · have hs := (Classical.choose_spec (exists_smul_rep h2 (hΔ k) (hF k) h)).2
        have := congrFun hs c
        simp only [ν, h, coordsZ_e]
        exact this
  rw [hx']
  exact eval_coordsZ_eq_zero (fun lam => mem_vanish.mp hP g (Set.mem_univ _) lam) ν

end Null

end LSG.ME
