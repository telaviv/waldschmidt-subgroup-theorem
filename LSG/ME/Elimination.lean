import Mathlib

/-!
# Main theorem of elimination theory for (multi)projective factors

Let `K` be an algebraically closed field, `σ` an arbitrary type of affine variables and `τ` a
finite type of projective variables, partitioned into blocks by `b : τ → κ` (`κ` finite). For a
set `J` of polynomials in `K[σ ⊕ τ]`, each homogeneous in every block (i.e. weighted homogeneous
for the weight `Sum.elim 0 (blockWeight b)`), the projection
`proj b J = {x | ∃ y, y ≠ 0 in every block ∧ ∀ f ∈ J, f (x, y) = 0}` is Zariski closed in `K^σ`
(`isClosed_proj_blocks`). The one-block case is `isClosed_proj`.

## Proof

We work with `P = (K[σ])[τ]` (`projCore`). For `E : ℕ` let `S E` be the (finite) set of
`τ`-monomials of multidegree `(E, …, E)`. For any family `g : S E → P` of elements of the ideal
generated by `J` which are multihomogeneous of multidegree `(E, …, E)`, the determinant of the
coefficient matrix `(coeff t' (g t))_{t,t'}` (a polynomial in `K[σ]`) belongs to `J'`. Then:

* if `x ∈ proj J` with witness `y`, the vector `(y^t)_{t ∈ S E}` is a nonzero kernel vector of the
  specialised matrix, so every element of `J'` vanishes at `x`;
* if `x ∉ proj J`, the projective Nullstellensatz (from
  `MvPolynomial.vanishingIdeal_zeroLocus_eq_radical`) gives `E` with every monomial of multidegree
  `(E, …, E)` in the specialised ideal `J(x)`; each such monomial lifts to a multihomogeneous
  element of `(J)` (homogeneous components of a homogeneous ideal), and the corresponding
  coefficient matrix specialises to the identity.

No uniformity of `E` in `x` is needed: `J'` is the union over all `E`.
-/

namespace LSG.ME

open MvPolynomial

section Core

variable {K : Type*} [Field K]
variable {σ τ κ : Type*} [Fintype τ] [DecidableEq τ] [Fintype κ] [DecidableEq κ]

/-- The multigrading weight of a block structure `b : τ → κ`: variable `i` has degree one in
block `b i` and zero in the other blocks. -/
def blockWeight (b : τ → κ) : τ → (κ → ℕ) := fun i => Pi.single (b i) 1

/-- `y` is nonzero in every block of `b`. -/
def NonzeroInBlocks (b : τ → κ) (y : τ → K) : Prop := ∀ k, ∃ i, b i = k ∧ y i ≠ 0

/-- The projection for polynomials with coefficients in `K[σ]`. -/
def projCore (b : τ → κ) (J : Set (MvPolynomial τ (MvPolynomial σ K))) : Set (σ → K) :=
  {x | ∃ y : τ → K, NonzeroInBlocks b y ∧ ∀ f ∈ J, eval y (map (eval x) f) = 0}

omit [Fintype κ] [DecidableEq τ] in
lemma weight_blockWeight_apply (b : τ → κ) (t : τ →₀ ℕ) (k : κ) :
    Finsupp.weight (blockWeight b) t k = ∑ i, if b i = k then t i else 0 := by
  rw [Finsupp.weight_eq_sum, Finset.sum_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [blockWeight, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
  split_ifs with h1 h2 h2 <;> simp_all

omit [Fintype κ] [DecidableEq τ] in
lemma le_of_weight_blockWeight (b : τ → κ) {t : τ →₀ ℕ} {E : ℕ}
    (ht : Finsupp.weight (blockWeight b) t = fun _ => E) (i : τ) : t i ≤ E := by
  have h := congrFun ht (b i)
  rw [weight_blockWeight_apply] at h
  rw [← h]
  have := Finset.single_le_sum (f := fun j => if b j = b i then t j else 0)
    (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
  simpa using this

/-- The finite set of `τ`-monomials of multidegree `(E, …, E)`. -/
noncomputable def monos (b : τ → κ) (E : ℕ) : Finset (τ →₀ ℕ) :=
  {t ∈ Finset.Icc 0 (Finsupp.equivFunOnFinite.symm fun _ => E) |
    Finsupp.weight (blockWeight b) t = fun _ => E}

lemma mem_monos {b : τ → κ} {E : ℕ} {t : τ →₀ ℕ} :
    t ∈ monos b E ↔ Finsupp.weight (blockWeight b) t = fun _ => E := by
  unfold monos
  rw [Finset.mem_filter, Finset.mem_Icc]
  refine ⟨fun h => h.2, fun h => ⟨⟨zero_le, Finsupp.le_def.2 fun i => ?_⟩, h⟩⟩
  simpa using le_of_weight_blockWeight b h i

/-- The coefficient matrix of a family of polynomials indexed by `monos b E`. -/
noncomputable def coeffMat {b : τ → κ} {E : ℕ}
    (g : monos b E → MvPolynomial τ (MvPolynomial σ K)) :
    Matrix (monos b E) (monos b E) (MvPolynomial σ K) :=
  fun t t' => (g t).coeff t'

/-- The eliminant set: all determinants of coefficient matrices of multihomogeneous families of
multidegree `(E, …, E)` in the ideal generated by `J`, for all `E`. -/
noncomputable def eliminants (b : τ → κ) (J : Set (MvPolynomial τ (MvPolynomial σ K))) :
    Set (MvPolynomial σ K) :=
  {p | ∃ E : ℕ, ∃ g : monos b E → MvPolynomial τ (MvPolynomial σ K),
    (∀ t, g t ∈ Ideal.span J ∧ IsWeightedHomogeneous (blockWeight b) (g t) fun _ => E) ∧
      p = (coeffMat g).det}

/-- Evaluation of a specialised polynomial of multidegree `(E, …, E)` as a finite sum over
`monos b E`. -/
lemma eval_map_eq_sum {b : τ → κ} {E : ℕ} {g : MvPolynomial τ (MvPolynomial σ K)}
    (hg : IsWeightedHomogeneous (blockWeight b) g fun _ => E) (x : σ → K) (y : τ → K) :
    eval y (map (eval x) g) =
      ∑ t : monos b E, eval x (g.coeff t) * ∏ i, y i ^ (t : τ →₀ ℕ) i := by
  rw [eval_eq', Finset.sum_coe_sort (monos b E)
    (fun t => eval x (g.coeff t) * ∏ i, y i ^ t i)]
  have hsub : (map (eval x) g).support ⊆ monos b E := fun t ht => by
    rw [mem_support_iff, coeff_map] at ht
    refine mem_monos.2 (hg fun h => ht ?_)
    rw [h, map_zero]
  rw [Finset.sum_subset hsub (fun t _ ht => by rw [notMem_support_iff.1 ht, zero_mul])]
  simp [coeff_map]

/-- Direction 1: the eliminants vanish on the projection. -/
lemma eval_eliminant_eq_zero {b : τ → κ} {J : Set (MvPolynomial τ (MvPolynomial σ K))}
    {x : σ → K} (hx : x ∈ projCore b J) {p : MvPolynomial σ K} (hp : p ∈ eliminants b J) :
    eval x p = 0 := by
  classical
  obtain ⟨y, hy, hJ⟩ := hx
  obtain ⟨E, g, hg, rfl⟩ := hp
  -- the specialisation kills the ideal generated by `J`
  have hker : Ideal.span J ≤ RingHom.ker ((eval y).comp (map (eval x))) :=
    Ideal.span_le.2 fun f hf => by simpa using hJ f hf
  set v : monos b E → K := fun t => ∏ i, y i ^ (t : τ →₀ ℕ) i
  rw [RingHom.map_det, ← Matrix.exists_mulVec_eq_zero_iff]
  refine ⟨v, ?_, ?_⟩
  · -- a monomial of multidegree `(E, …, E)` not vanishing at `y`
    choose c hcb hcy using hy
    let t : τ →₀ ℕ := ∑ k, Finsupp.single (c k) E
    have ht : t ∈ monos b E := by
      rw [mem_monos, map_sum]
      simp only [Finsupp.weight_single, blockWeight, hcb]
      ext k
      simp [Finset.sum_apply, Pi.single_apply]
    intro hv
    have := congrFun hv ⟨t, ht⟩
    simp only [v, Pi.zero_apply] at this
    obtain ⟨i, -, hi⟩ := Finset.prod_eq_zero_iff.1 this
    rw [pow_eq_zero_iff'] at hi
    apply hi.2
    simp only [t, Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply]
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [ite_eq_right_iff]
    rintro rfl
    exact absurd hi.1 (hcy k)
  · ext t
    have h0 := hker (hg t).1
    rw [RingHom.mem_ker, RingHom.comp_apply, eval_map_eq_sum (hg t).2] at h0
    simpa [Matrix.mulVec, dotProduct, coeffMat, v] using h0

omit [Fintype τ] [DecidableEq τ] in
/-- Specialisation of coefficients commutes with weighted homogeneous components. -/
lemma map_weightedHomogeneousComponent {R S M : Type*} [CommSemiring R] [CommSemiring S]
    [AddCommMonoid M] (φ : R →+* S) (w : τ → M) (D : M) (g : MvPolynomial τ R) :
    map φ (weightedHomogeneousComponent w D g) = weightedHomogeneousComponent w D (map φ g) := by
  classical
  ext d
  simp only [coeff_map, coeff_weightedHomogeneousComponent]
  split_ifs <;> simp

omit [Fintype τ] [DecidableEq τ] [Fintype κ] in
attribute [local instance] MvPolynomial.weightedGradedAlgebra in
/-- Lifting: a multihomogeneous element of the specialised ideal `J(x)` is the specialisation of a
multihomogeneous element (of the same multidegree) of the ideal generated by `J`. -/
lemma exists_lift {b : τ → κ} {J : Set (MvPolynomial τ (MvPolynomial σ K))}
    (hJ : ∀ f ∈ J, ∃ d, IsWeightedHomogeneous (blockWeight b) f d) (x : σ → K)
    {q : MvPolynomial τ K} {D : κ → ℕ} (hq : q ∈ Ideal.span (map (eval x) '' J))
    (hqh : IsWeightedHomogeneous (blockWeight b) q D) :
    ∃ g ∈ Ideal.span J, IsWeightedHomogeneous (blockWeight b) g D ∧ map (eval x) g = q := by
  classical
  have hsurj : Function.Surjective
      (map (eval x) : MvPolynomial τ (MvPolynomial σ K) →+* MvPolynomial τ K) := fun q =>
    ⟨map C q, by ext; simp [coeff_map]⟩
  rw [← Ideal.map_span, Ideal.mem_map_iff_of_surjective _ hsurj] at hq
  obtain ⟨g₀, hg₀, rfl⟩ := hq
  have hhom : (Ideal.span J).IsHomogeneous
      (weightedHomogeneousSubmodule (MvPolynomial σ K) (blockWeight b)) :=
    Ideal.homogeneous_span _ _ fun f hf => (hJ f hf).imp fun _ hd => hd
  refine ⟨weightedHomogeneousComponent (blockWeight b) D g₀,
    weightedHomogeneousComponent_mem_of_mem _ _ hhom hg₀ D,
    weightedHomogeneousComponent_isWeightedHomogeneous _ _, ?_⟩
  rw [map_weightedHomogeneousComponent, hqh.weightedHomogeneousComponent_same]

/-- Direction 2 (projective Nullstellensatz): off the projection some eliminant does not vanish. -/
lemma exists_eliminant_ne_zero [IsAlgClosed K] {b : τ → κ}
    {J : Set (MvPolynomial τ (MvPolynomial σ K))}
    (hJ : ∀ f ∈ J, ∃ d, IsWeightedHomogeneous (blockWeight b) f d) {x : σ → K}
    (hx : x ∉ projCore b J) : ∃ p ∈ eliminants b J, eval x p ≠ 0 := by
  classical
  set I : Ideal (MvPolynomial τ K) := Ideal.span (map (eval x) '' J) with hI
  -- Step 1: for every choice of one variable per block, a power of their product lies in `J(x)`.
  have h1 : ∀ c : κ → τ, ∃ n : ℕ,
      (∀ k, b (c k) = k) → (∏ k, X (c k) : MvPolynomial τ K) ^ n ∈ I := by
    intro c
    by_cases hc : ∀ k, b (c k) = k
    · have hrad : (∏ k, X (c k) : MvPolynomial τ K) ∈ I.radical := by
        rw [← vanishingIdeal_zeroLocus_eq_radical (K := K)]
        intro y hy
        rw [mem_zeroLocus_iff] at hy
        have hyJ : ∀ f ∈ J, eval y (map (eval x) f) = 0 := fun f hf => by
          simpa using hy _ (Ideal.subset_span ⟨f, hf, rfl⟩)
        have hny : ¬ NonzeroInBlocks b y := fun h => hx ⟨y, h, hyJ⟩
        simp only [NonzeroInBlocks, not_forall, not_exists, not_and, not_not] at hny
        obtain ⟨k, hk⟩ := hny
        simpa using Finset.prod_eq_zero (Finset.mem_univ k) (hk (c k) (hc k))
      obtain ⟨n, hn⟩ := hrad
      exact ⟨n, fun _ => hn⟩
    · exact ⟨0, fun h => absurd h hc⟩
  choose n hn using h1
  set N := Finset.univ.sup n
  set E := (N + 1) * (Fintype.card τ + 1)
  -- Step 2: every monomial of multidegree `(E, …, E)` lies in `J(x)`.
  have h2 : ∀ t : τ →₀ ℕ, Finsupp.weight (blockWeight b) t = (fun _ => E) →
      (monomial t 1 : MvPolynomial τ K) ∈ I := by
    intro t ht
    have hex : ∀ k, ∃ i, b i = k ∧ N ≤ t i := by
      intro k
      by_contra hne
      push Not at hne
      have h := congrFun ht k
      rw [weight_blockWeight_apply] at h
      have hle : ∑ i, (if b i = k then t i else 0) ≤ ∑ _i : τ, N :=
        Finset.sum_le_sum fun i _ => by
          split_ifs with hb
          · exact (hne i hb).le
          · exact Nat.zero_le _
      rw [h, Finset.sum_const, Finset.card_univ, smul_eq_mul,
        show E = (N + 1) * (Fintype.card τ + 1) from rfl] at hle
      nlinarith
    choose c hcb hct using hex
    have hcinj : Function.Injective c := fun k k' h => by rw [← hcb k, ← hcb k', h]
    refine Ideal.mem_of_dvd _ ?_
      (Ideal.pow_mem_of_pow_mem I (hn c hcb) (Finset.le_sup (Finset.mem_univ c)))
    rw [monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      ← Finset.prod_pow]
    calc ∏ k, (X (c k) : MvPolynomial τ K) ^ N = ∏ i ∈ Finset.univ.image c, X i ^ N :=
          (Finset.prod_image (f := fun i => (X i : MvPolynomial τ K) ^ N)
            fun k _ k' _ h => hcinj h).symm
      _ ∣ ∏ i ∈ Finset.univ.image c, X i ^ t i := Finset.prod_dvd_prod_of_dvd _ _ fun i hi => by
          obtain ⟨k, -, rfl⟩ := Finset.mem_image.1 hi
          exact pow_dvd_pow _ (hct k)
      _ ∣ ∏ i, X i ^ t i := Finset.prod_dvd_prod_of_subset _ _ _ (Finset.subset_univ _)
  -- Step 3: lift these monomials to multihomogeneous elements of `(J)`.
  have h3 : ∀ t : monos b E, ∃ g ∈ Ideal.span J,
      IsWeightedHomogeneous (blockWeight b) g (fun _ => E) ∧
        map (eval x) g = monomial (t : τ →₀ ℕ) 1 := fun t =>
    exists_lift hJ x (h2 t (mem_monos.1 t.2))
      (isWeightedHomogeneous_monomial _ _ _ (mem_monos.1 t.2))
  choose g hgJ hgh hgx using h3
  -- Step 4: the coefficient matrix specialises to the identity.
  refine ⟨(coeffMat g).det, ⟨E, g, fun t => ⟨hgJ t, hgh t⟩, rfl⟩, ?_⟩
  rw [RingHom.map_det]
  have hone : (eval x).mapMatrix (coeffMat g) = 1 := by
    ext t t'
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, coeffMat, ← coeff_map, hgx,
      coeff_monomial, Matrix.one_apply, Subtype.ext_iff]
  rw [hone, Matrix.det_one]
  exact one_ne_zero

omit [Fintype τ] [DecidableEq τ] [Fintype κ] in
/-- **Main theorem of elimination theory** (core form, coefficients in `K[σ]`): the projection
along multiprojective factors of the common zeros of multihomogeneous polynomials is Zariski
closed. -/
theorem isClosed_projCore [IsAlgClosed K] [Finite τ] [Finite κ] (b : τ → κ)
    (J : Set (MvPolynomial τ (MvPolynomial σ K)))
    (hJ : ∀ f ∈ J, ∃ d, IsWeightedHomogeneous (blockWeight b) f d) :
    ∃ J' : Set (MvPolynomial σ K), projCore b J = {x | ∀ p ∈ J', eval x p = 0} := by
  classical
  have := Fintype.ofFinite τ
  have := Fintype.ofFinite κ
  exact ⟨eliminants b J, Set.ext fun _ => ⟨fun hx _ hp => eval_eliminant_eq_zero hx hp,
    fun h => by_contra fun hx =>
      let ⟨p, hp, hne⟩ := exists_eliminant_ne_zero hJ hx; hne (h p hp)⟩⟩

end Core

section Sum

variable {K : Type*} [Field K]
variable {σ τ κ : Type*} [DecidableEq κ]

/-- The projection to `K^σ` of the common zeros of `J ⊆ K[σ ⊕ τ]` in `K^σ × ∏_k ℙ(block k)`:
the set of `x` such that some `y`, nonzero in every block of `b`, satisfies `f (x, y) = 0` for all
`f ∈ J`. -/
def projBlocks (b : τ → κ) (J : Set (MvPolynomial (σ ⊕ τ) K)) : Set (σ → K) :=
  {x | ∃ y : τ → K, NonzeroInBlocks b y ∧ ∀ f ∈ J, eval (Sum.elim x y) f = 0}

/-- The canonical map `K[σ ⊕ τ] → (K[σ])[τ]`. -/
noncomputable def toCoeff : MvPolynomial (σ ⊕ τ) K →ₐ[K] MvPolynomial τ (MvPolynomial σ K) :=
  aeval (Sum.elim (fun s => C (X s)) X)

lemma eval_map_toCoeff (x : σ → K) (y : τ → K) (f : MvPolynomial (σ ⊕ τ) K) :
    eval y (map (eval x) (toCoeff f)) = eval (Sum.elim x y) f := by
  have : ((eval y).comp (map (eval x))).comp (toCoeff (σ := σ) (τ := τ) (K := K)).toRingHom =
      eval (Sum.elim x y) := by
    apply MvPolynomial.ringHom_ext
    · intro r; simp [toCoeff]
    · rintro (s | i) <;> simp [toCoeff]
  exact DFunLike.congr_fun this f

lemma isWeightedHomogeneous_toCoeff {M : Type*} [AddCommMonoid M] {w : τ → M}
    {f : MvPolynomial (σ ⊕ τ) K} {d : M} (hf : IsWeightedHomogeneous (Sum.elim 0 w) f d) :
    IsWeightedHomogeneous w (toCoeff f) d := by
  classical
  rw [f.as_sum, map_sum]
  refine IsWeightedHomogeneous.sum _ _ _ fun s hs => ?_
  rw [← hf (mem_support_iff.1 hs), toCoeff, aeval_monomial, Finsupp.weight_apply, Finsupp.sum,
    Finsupp.prod, show algebraMap K (MvPolynomial τ (MvPolynomial σ K)) (f.coeff s) =
      C (C (f.coeff s)) from rfl]
  refine IsWeightedHomogeneous.C_mul (IsWeightedHomogeneous.prod _ _ _ fun i _ => ?_) _
  rcases i with a | i
  · simpa using (isWeightedHomogeneous_C w (X a : MvPolynomial σ K)).pow (s (Sum.inl a))
  · simpa using (isWeightedHomogeneous_X (MvPolynomial σ K) w i).pow (s (Sum.inr i))

/-- **Main theorem of elimination theory for multiprojective factors.** Let `K` be algebraically
closed and `J ⊆ K[σ ⊕ τ]` a set of polynomials, each homogeneous in every block of `b : τ → κ`
(weighted homogeneous for `Sum.elim 0 (blockWeight b)`: the `σ`-variables have weight `0`). Then
the projection `projBlocks b J ⊆ K^σ` is Zariski closed. -/
theorem isClosed_proj_blocks [IsAlgClosed K] [Finite τ] [Finite κ] (b : τ → κ)
    (J : Set (MvPolynomial (σ ⊕ τ) K))
    (hJ : ∀ f ∈ J, ∃ d, IsWeightedHomogeneous (Sum.elim 0 (blockWeight b)) f d) :
    ∃ J' : Set (MvPolynomial σ K), projBlocks b J = {x | ∀ p ∈ J', eval x p = 0} := by
  obtain ⟨J', hJ'⟩ := isClosed_projCore b (toCoeff '' J) (by
    rintro _ ⟨f, hf, rfl⟩
    obtain ⟨d, hd⟩ := hJ f hf
    exact ⟨d, isWeightedHomogeneous_toCoeff hd⟩)
  refine ⟨J', ?_⟩
  rw [← hJ']
  ext x
  simp only [projBlocks, projCore, Set.mem_ofPred_eq, Set.forall_mem_image, eval_map_toCoeff]

/-- The projection along a single projective factor `ℙ(K^τ)`. -/
def proj (J : Set (MvPolynomial (σ ⊕ τ) K)) : Set (σ → K) :=
  {x | ∃ y : τ → K, y ≠ 0 ∧ ∀ f ∈ J, eval (Sum.elim x y) f = 0}

/-- **Main theorem of elimination theory, one projective factor.** If `K` is algebraically closed
and every `f ∈ J ⊆ K[σ ⊕ τ]` is homogeneous in the `τ`-variables (weighted homogeneous for the
weight `Sum.elim 0 1`), then `proj J = {x | ∃ y ≠ 0, ∀ f ∈ J, f (x, y) = 0}` is Zariski closed. -/
theorem isClosed_proj [IsAlgClosed K] [Finite τ] (J : Set (MvPolynomial (σ ⊕ τ) K))
    (hJ : ∀ f ∈ J, ∃ d : ℕ, IsWeightedHomogeneous (Sum.elim 0 1 : σ ⊕ τ → ℕ) f d) :
    ∃ J' : Set (MvPolynomial σ K), proj J = {x | ∀ p ∈ J', eval x p = 0} := by
  have hJ1 : ∀ f ∈ J, ∃ d,
      IsWeightedHomogeneous (Sum.elim 0 (blockWeight fun _ : τ => ())) f d := by
    intro f hf
    obtain ⟨d, hd⟩ := hJ f hf
    refine ⟨fun _ => d, fun s hs => funext fun u => ?_⟩
    rw [← hd hs, Finsupp.weight_apply, Finsupp.weight_apply, Finsupp.sum, Finsupp.sum,
      Finset.sum_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    rcases i with a | i <;> simp [blockWeight]
  obtain ⟨J', hJ'⟩ := isClosed_proj_blocks (fun _ : τ => ()) J hJ1
  refine ⟨J', ?_⟩
  rw [← hJ']
  ext x
  simp [proj, projBlocks, NonzeroInBlocks, Function.ne_iff]

/-- The product case `∏_k ℙ^{N k}` (e.g. `(ℙ²)^m` with `κ = Fin m`, `N = fun _ => 2`): the
projective variables are `Σ k, Fin (N k + 1)` and the blocks are the fibres of `Sigma.fst`. -/
theorem isClosed_proj_sigma [IsAlgClosed K] [Finite κ] {N : κ → ℕ}
    (J : Set (MvPolynomial (σ ⊕ (Σ k, Fin (N k + 1))) K))
    (hJ : ∀ f ∈ J, ∃ d, IsWeightedHomogeneous (Sum.elim 0 (blockWeight Sigma.fst)) f d) :
    ∃ J' : Set (MvPolynomial σ K),
      {x : σ → K | ∃ y : (Σ k, Fin (N k + 1)) → K, (∀ k, ∃ j, y ⟨k, j⟩ ≠ 0) ∧
        ∀ f ∈ J, eval (Sum.elim x y) f = 0} = {x | ∀ p ∈ J', eval x p = 0} := by
  obtain ⟨J', hJ'⟩ := isClosed_proj_blocks Sigma.fst J hJ
  refine ⟨J', ?_⟩
  rw [← hJ']
  ext x
  simp only [projBlocks, NonzeroInBlocks, Set.mem_ofPred_eq, Sigma.exists]
  constructor
  · rintro ⟨y, hy, hJy⟩
    exact ⟨y, fun k => let ⟨j, hj⟩ := hy k; ⟨k, j, rfl, hj⟩, hJy⟩
  · rintro ⟨y, hy, hJy⟩
    refine ⟨y, fun k => ?_, hJy⟩
    obtain ⟨k', j, rfl, hj⟩ := hy k
    exact ⟨j, hj⟩

end Sum

end LSG.ME
